{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc", "node", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "rules": {
    "no-console": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    // Parked type-aware/test-quality rules: each has dozens of pre-existing
    // findings (mostly narrowing casts + untyped vi.fn mocks in tests).
    // Re-enable one per follow-up PR, fixing or inline-suppressing findings.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/consistent-return": "error",
    "vitest/require-mock-type-parameters": "error",
    "vitest/require-to-throw-message": "off",
    "node/no-process-env": "error",
    "no-unused-vars": [
      "error",
      {"argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true}
    ],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "warn",
      {"prefer": "type-imports", "fixStyle": "separate-type-imports"}
    ],
    "typescript/no-non-null-assertion": "warn",
    "no-underscore-dangle": ["warn", {"allow": ["_attempts", "_u", "__dirname"]}],
    "import/no-default-export": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/no-unassigned-import": ["error", {"allow": ["**/*.css", "server-only"]}]
  },
  "overrides": [
    {
      "files": [
        "**/scripts/**",
        "**/*.config.*",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/e2e/**",
        "**/e2e-ssr/**",
        "**/tests/**",
        "**/netlify/plugins/**"
      ],
      "rules": {
        "no-console": "off",
        "no-unsafe-finally": "off",
        "import/no-unassigned-import": "off",
        "node/no-process-env": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": ["**/env.ts", "**/env.node.ts", "**/env.test.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      // React-DOM-shaped rules that misfire on React Native / Expo idioms:
      // Gesture.Tap()/Gesture.Pan() builders (capitalized-calls) and
      // expo-status-bar's string `style` prop (style-prop-object).
      "files": ["apps/mobile/**"],
      "rules": {
        "react/capitalized-calls": "off",
        "react/style-prop-object": "off"
      }
    },
    {
      "files": ["**/jest.setup.*"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["**/*.config.*"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/app/**/*.tsx", "**/app/**/*.ts", "**/pages/**/*.tsx", "**/pages/**/*.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off",
        "typescript/consistent-type-imports": "off",
        "typescript/consistent-type-definitions": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.astro/**",
    "**/.netlify/**",
    "**/.expo/**",
    "**/.turbo/**",
    "**/drizzle/**",
    "**/routeTree.gen.ts"
  ]
}
