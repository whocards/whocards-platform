{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "with-env": "dotenv -e ../../.env${ENV:+.${ENV}} --",
    "start": "pnpm with-env expo start --dev-client",
    "android": "pnpm with-env expo start --dev-client --android",
    "android:build": "pnpm with-env expo run:android",
    "ios": "pnpm with-env expo start --dev-client --ios",
    "web": "pnpm with-env expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "oxlint --deny-warnings",
    "e2e:ios": "maestro test .maestro --exclude-tags=screenshots,android-only -e APP_ID=cc.whocards.mobile",
    "e2e:android": "maestro test .maestro --exclude-tags=screenshots -e APP_ID=com.whocards.mobile",
    "screenshots": "bash scripts/capture-screenshots.sh",
    "ui-diff": "bash scripts/ui-diff.sh",
    "eas": "pnpx eas-cli@latest",
    "eas:build:ios": "pnpx eas-cli@latest build -p ios --profile production",
    "eas:build:android": "pnpx eas-cli@latest build -p android --profile production",
    "eas:submit:ios": "pnpx eas-cli@latest submit -p ios --profile production --latest",
    "eas:submit:android": "pnpx eas-cli@latest submit -p android --profile production --latest",
    "eas:update": "pnpx eas-cli@latest update --channel production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@whocards/api": "workspace:*",
    "@whocards/decks": "workspace:*",
    "@whocards/observability": "workspace:*",
    "@whocards/tokens": "workspace:*",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "nativewind": "5.0.0-preview.4",
    "posthog-react-native": "^4.85.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "catalog:"
  },
  "//lightningcss": "A peer dependency of react-native-css, not something this app imports — it is listed (and pinned) only so the peer resolves. The exact version is in lockstep with the '@expo/metro-config>lightningcss' override in pnpm-workspace.yaml; that comment carries the reason for the pin and the condition for removing both. Bump the two together or not at all.",
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "~58.0.24",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "lightningcss": "1.30.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3"
  }
}
