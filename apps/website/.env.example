# Copy to .env and fill in values. Never commit .env.

# Database
DB_URL=

# Google Sheets (contact exports)
CONTACTS_SHEET_URL=

# Resend — transactional email. All four values below are REQUIRED (build fails
# without them) so a misconfigured deploy fails loudly instead of silently dropping
# email or consent events.
RESEND_API_KEY=
RESEND_FROM_EMAIL=WhoCards <hello@whocards.cc>

# Resend Segment (Audience) ids for consent sync (#120).
# Find these in Resend → Contacts → Segments → copy the segment id.
RESEND_SEGMENT_NEWSLETTER_ID=
RESEND_SEGMENT_APP_WAITLIST_ID=

# Resend webhook signing secret for verifying Svix signatures (#121), format whsec_...
# Must match the endpoint's signing_secret: Resend → Webhooks → your endpoint,
# or GET https://api.resend.com/webhooks/{id}.
RESEND_WEBHOOK_SECRET=

# PostHog
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://who.whocards.cc
PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# App store launch flags. /app is visible (download mode) when either is true,
# and redirects home when both are false. iOS is public today; Android trails
# through its Closed Test, so its tile routes to /android-testers until flipped.
PUBLIC_APP_IOS_LAUNCHED=true
PUBLIC_APP_ANDROID_LAUNCHED=false

# --- Public stats page (/stats) — all OPTIONAL. Each metric degrades to a "not
# connected yet" state on the page when its source's vars are unset; none of
# these gate the build. See @whocards/analytics for the source clients.

# App Store Connect (iOS installs). App Store Connect → Users and Access →
# Integrations → App Store Connect API → create a key with the "Sales and
# Reports" role. KEY_ID/ISSUER_ID are shown there; PRIVATE_KEY is the full .p8
# file contents (downloaded once — paste the whole PEM, BEGIN/END lines incl.).
# VENDOR_NUMBER is the numeric Vendor Number under your account name.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
APP_STORE_CONNECT_VENDOR_NUMBER=

# Google Play (Android installs). Play Console → Setup → API access → link/create
# a Google Cloud service account with a JSON key — paste the full downloaded file
# contents into SERVICE_ACCOUNT_JSON. Grant that account "Viewer" account access,
# then copy the `pubsite_prod_rev_*` bucket name shown under "Download reports".
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_REPORTS_BUCKET=

# PostHog HogQL query API — country split only (everything else on the stats
# page reads Postgres directly). PostHog → Settings → Personal → Personal API
# Keys, scope it to "Query read" only for this project. PROJECT_ID is under
# Settings → Project → Project API keys.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
