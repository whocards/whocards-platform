{
  "name": "website",
  "type": "module",
  "version": "1.4.1",
  "private": true,
  "scripts": {
    "with-env": "dotenv -e ../../.env${ENV:+.${ENV}} --",
    "dev": "pnpm with-env astro dev",
    "start": "pnpm with-env astro dev",
    "build": "pnpm with-env astro build && node scripts/seo-postbuild.mjs",
    "preview": "pnpm with-env astro preview",
    "typecheck": "astro sync && astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ssr": "playwright test -c playwright.ssr.config.ts",
    "test:performance:lcp": "pnpm build && node scripts/mobile-lighthouse.mjs",
    "analyze": "pnpx unlighthouse --site https://whocards.cc",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "reconcile:resend": "pnpm with-env tsx scripts/reconcile-resend.ts",
    "game:retention": "pnpm with-env tsx scripts/game-retention.ts",
    "stats:refresh": "pnpm with-env node scripts/refresh-stats.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@iconify-icon/react": "^3.0.6",
    "@iconify-json/entypo-social": "^1.2.3",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/zondicons": "^1.2.2",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@whocards/api": "workspace:*",
    "@whocards/app-store": "workspace:*",
    "@whocards/decks": "workspace:*",
    "@whocards/emails": "workspace:*",
    "@whocards/env": "workspace:*",
    "@whocards/game": "workspace:*",
    "@whocards/observability": "workspace:*",
    "@whocards/tokens": "workspace:*",
    "astro": "^7.4.13",
    "astro-icon": "^1.2.0",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0",
    "bidi-js": "^1.1.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.8.2",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "nanostores": "^1.5.5",
    "object-to-formdata": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.454.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "^6.39.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.5",
    "split-text-js": "^1.0.3",
    "svix": "^1.96.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "wawoff2": "^2.0.1",
    "zod": "catalog:",
