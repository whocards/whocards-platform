---
import {Icon} from 'astro-icon/components'
import PreorderSection from '~components/Purchase/PreorderSection.astro'
import Button from '~components/ui/Button.astro'
import Layout from '~layouts/Layout.astro'

// "The Third Relationship" — a free, facilitated prototype for teams, run
// jointly by Inner Mastery Lab (Tamas) and WhoCards. Cards from the AI
// Check-In deck open the room; a facilitated conversation goes where it's
// hardest. Copy came from Tamas; layout follows docs/DESIGN.md and the
// /ai-at-work page (same eyebrow → title → copy → one primary action rhythm).

const deckHref = '/play/ai-at-work'

// The three Cards shown in "Open" are real Questions from the AI Check-In
// deck (packages/decks/src/decks/ai-at-work.questions.json), so each one
// links straight into the deck at that Question.
const openingCards = [
  {
    id: 'ai-4',
    text: "Is there something about AI at work you've been afraid to say out loud here?",
  },
  {id: 'ai-7', text: 'What would it take for you to feel safe, not threatened, by these changes?'},
  {
    id: 'ai-11',
    text: 'One task you would never want to hand over, no matter how good the tools get?',
  },
]

const applyHref =
  'mailto:tamas@innermasterylab.co?subject=' +
  encodeURIComponent('Team AI Relationship — Prototype Application') +
  '&body=' +
  encodeURIComponent(
    'Team/company:\nRole:\nTeam size:\nWhat we’re noticing about AI on the team:\n'
  )

const now = [
  "Everyone's AI use is private, invisible, unexamined",
  'Strange output reads as incompetence, not difference',
  'Feedback about AI use only flows downward, if at all',
  "The team's blind spots are individually held, never pooled",
]

const next = [
  'How each person is actually relating to AI, out loud',
  "Where the team's collective blind spots actually sit",
  "A live, bottom-up feedback channel most orgs don't have",
  'A shared baseline — not a shared method',
]

const specs = [
  {
    k: 'Format',
    v: 'One session with your team,',
    dim: '2–3 hours — cards, then the conversation, in person or remote',
  },
  {
    k: 'Cost',
    v: 'Free — this is a prototype,',
    dim: "we're building the next stage of this work with a small number of teams",
  },
  {
    k: 'In return',
    v: "Honest participation, and a debrief conversation afterward on what landed and what didn't",
  },
  {k: 'Spots', v: 'A handful of teams,', dim: 'this round'},
]

const audiences = [
  "Heads of AI, transformation leads, and founders steering how their team adopts AI — and sensing it's become more than a tooling question.",
  "Teams doing work that matters to them — sustainability, health, education, ethical business — where how people work together isn't a side issue.",
  "Organizations that don't have a real channel for feedback to travel upward, and are curious whether this could become one.",
]

const people = [
  {
    name: 'Tamas Meszaros',
    role: 'Founder, Inner Mastery Lab',
    bio: 'I built the first legal-documentation automation system inside Morgan Stanley before "AI coaching" was a category anyone had named. I\'ve spent the fifteen years since learning that the infrastructure that actually determines whether a team holds together isn\'t the technical kind. I coach senior leaders and founders on exactly this gap — and this prototype is where that work meets the newest relationship any of us have had to build.',
  },
  {
    name: 'Avi',
    role: 'Founder, WhoCards',
    bio: 'WhoCards exists because nobody owns the space where a team talks honestly — the fear, the identity questions, the trust gaps that block real change. I built the AI Check-In deck to give a room the ritual it needs to get past "what do you do?" and toward what\'s actually going on. This prototype is that ritual, aimed at the relationship your team hasn\'t named yet.',
  },
]
---

<Layout
  title='The Third Relationship: A Free Team Experience for AI at Work'
  description='A free, facilitated experience for teams navigating their relationship with AI — WhoCards to open the room, then the harder conversation. A handful of teams this round.'
  class='scrollbar-hide'
>
  <!-- 1. HERO -->
  <section
    class='relative flex min-h-[calc(100vh-4rem)] w-full max-w-5xl flex-col items-center justify-center gap-6 px-8 text-center lg:gap-8'
  >
    <h3
      class='text-sm font-semibold uppercase leading-snug tracking-wide text-primary-dark lg:text-base'
    >
      Inner Mastery Lab × WhoCards · free prototype
    </h3>
    <h1 class='font-title text-4xl font-bold leading-tight text-white lg:text-7xl lg:leading-tight'>
      Your team already has a relationship with AI. Nobody's <span class='text-gradient'>aware</span
      > of it.
    </h1>
    <p class='max-w-2xl text-sm font-semibold leading-7 lg:text-lg'>
      A facilitated experience — cards first, then the harder conversation — for teams navigating
      the newest relationship in the room, before it quietly reshapes all the others.
    </p>
    <div class='w-full max-w-xs pt-2'>
      <Button tag='a' href={applyHref} size='lg' full hideIcon>Apply for a slot</Button>
    </div>
    <p class='text-xs text-gray-dark'>Free. One 2–3 hour session. A handful of teams this round.</p>
    <div class='absolute bottom-5 left-0 right-0 grid place-items-center'>
      <a
        href='#the-relationship-nobody-is-counting'
        class='scale-150 border-0 border-x-8 border-t-8 border-solid border-x-transparent border-t-primary-light transition-transform hover:scale-[2]'
        aria-label='Scroll to learn more'
      >
      </a>
    </div>
  </section>

  <!-- 2. DIAGRAM -->
  <section id='the-relationship-nobody-is-counting' class='w-full px-5 pt-16 lg:max-w-7xl xl:px-0'>
    <div
      class='mx-auto flex max-w-3xl flex-col items-center gap-6 rounded-3xl border border-gray-dark bg-background px-6 py-10 lg:px-12 lg:py-14'
    >
      <svg
        class='w-full max-w-[400px]'
        viewBox='0 0 400 170'
        xmlns='http://www.w3.org/2000/svg'
        role='img'
        aria-label='Diagram: two people have one relationship between them; once each person also has a relationship with AI, there are five relationships to manage instead of one.'
      >
        <g>
          <line x1='40' y1='58' x2='112' y2='58' class='stroke-gray-light' stroke-width='2'></line>
          <circle cx='40' cy='58' r='9' class='fill-white'></circle>
          <circle cx='112' cy='58' r='9' class='fill-white'></circle>
          <text x='76' y='96' text-anchor='middle' class='fill-gray-dark font-sans' font-size='12'
            >1 relationship</text
          >
          <text
            x='76'
            y='26'
            text-anchor='middle'
            class='fill-gray-dark font-sans font-semibold'
            font-size='11'>TWO PEOPLE</text
          >
        </g>

        <text x='188' y='63' text-anchor='middle' class='fill-gray-dark font-title' font-size='20'
          >→</text
        >

        <g>
          <line x1='260' y1='38' x2='260' y2='108' class='stroke-gray-light' stroke-width='2'
          ></line>
          <line x1='260' y1='38' x2='332' y2='38' class='stroke-primary-dark' stroke-width='2'
          ></line>
          <line x1='260' y1='108' x2='332' y2='108' class='stroke-primary-dark' stroke-width='2'
          ></line>
          <line
            x1='332'
            y1='38'
            x2='332'
            y2='108'
            class='stroke-primary-light'
            stroke-width='2'
            stroke-dasharray='4 4'></line>
          <line
            x1='260'
            y1='38'
            x2='332'
            y2='108'
            class='stroke-gray-light'
            stroke-width='1.4'
            stroke-dasharray='2 4'></line>

          <circle cx='260' cy='38' r='9' class='fill-white'></circle>
          <circle cx='260' cy='108' r='9' class='fill-white'></circle>
          <circle cx='332' cy='38' r='8' class='fill-primary-dark'></circle>
          <circle cx='332' cy='108' r='8' class='fill-primary-dark'></circle>

          <text
            x='296'
            y='142'
            text-anchor='middle'
            class='fill-primary-dark font-sans font-semibold'
            font-size='12'>5 relationships</text
          >
          <text
            x='296'
            y='18'
            text-anchor='middle'
            class='fill-gray-dark font-sans font-semibold'
            font-size='11'>+ THEIR AI</text
          >
        </g>
      </svg>
      <p class='max-w-md text-center text-sm leading-snug text-gray-dark lg:text-base'>
        Every person who adopts AI doesn't add one relationship to the team — they add one
        relationship <em class='not-italic font-semibold text-white'>each</em>, and nobody is
        holding how those interconnect. That's factorial growth, managed by nobody.
      </p>
    </div>
  </section>

  <!-- 3. WHAT'S HAPPENING -->
  <PreorderSection subtitle="what's actually happening">
    <Fragment slot='title'>
      Everyone's building a <span class='text-primary-dark'>different relationship</span> with the same
      machine.
    </Fragment>
    <div class='flex max-w-3xl flex-col gap-5'>
      <p class='text-base leading-7 text-white lg:text-lg'>
        Which sides of you get amplified. Who you are in that exchange. What you ask it, what you
        never ask it, what you quietly leave out. Every person on your team is answering these
        differently, alone, and nobody's comparing notes.
      </p>
      <p class='text-sm leading-snug text-gray-dark lg:text-base'>
        We keep treating this as an adoption problem — rollout, training, prompting technique. It
        isn't. It's a <strong class='font-semibold text-white'>relational</strong> one. And it's already
        shaping how your team makes decisions, gives feedback, and shows up for each other — whether or
        not anyone's named it out loud.
      </p>
    </div>
  </PreorderSection>

  <!-- 4. WHY IT MATTERS -->
  <PreorderSection subtitle='why it matters'>
    <Fragment slot='title'>
      Friction isn't the problem. The <span class='text-primary-light'>absence of it</span> is.
    </Fragment>
    <div class='flex max-w-3xl flex-col gap-5'>
      <p class='text-base leading-7 text-white lg:text-lg'>
        Teams don't fail because people disagree. They fail because disagreement has nowhere safe to
        go — so it goes underground, into bubbles, into silence.
      </p>
      <p class='text-sm leading-snug text-gray-dark lg:text-base'>
        Add an AI relationship nobody's talking about, and you get a new version of an old failure:
        someone's output looks strange, and instead of curiosity — <em
          >how are you using this thing?</em
        > — it reads as incompetence.
      </p>
      <blockquote
        class='rounded-2xl border-l-4 border-primary-dark bg-dark px-6 py-5 font-title text-lg font-bold leading-snug text-white lg:text-2xl'
      >
        The gap isn't skill. It's that the relationship behind the work was never made visible.
      </blockquote>
      <p class='text-sm leading-snug text-gray-dark lg:text-base'>
        The goal isn't for everyone to use AI the same way. It's to bring what's actually different
        to the same table.
      </p>
    </div>
  </PreorderSection>

  <!-- 5. THE EXPERIENCE -->
  <PreorderSection subtitle='the experience' class='w-full'>
    <Fragment slot='title'>
      Cards to open the room. Conversation to <span class='text-primary-dark'
        >go where it's hardest</span
      >.
    </Fragment>
    <div class='flex flex-col gap-8 lg:gap-10'>
      <p class='max-w-3xl text-sm leading-snug text-gray-dark lg:text-base'>
        This isn't a training or a tool demo. It's a capacity experience — the somatic groundwork
        that makes it possible for a room to say the true thing, followed by the conversation that
        groundwork was for.
      </p>

      <!-- Phase 1 — open with real Cards from the AI Check-In deck -->
      <div class='flex flex-col gap-4'>
        <h3 class='flex items-center gap-3 text-base font-semibold text-primary-light lg:text-lg'>
          <span
            class='grid h-7 w-7 shrink-0 place-items-center rounded-full bg-primary-light font-sans text-sm font-bold text-dark'
            aria-hidden='true'>1</span
          >
          Open — WhoCards'
          <a
            href='/ai-at-work'
            class='underline underline-offset-4 transition-colors hover:text-yellow-300'
            >AI Check-In deck</a
          >
        </h3>
        <p class='max-w-3xl text-sm leading-snug text-gray-dark lg:text-base'>
          We draw from real questions, one at a time, answered out loud — not an icebreaker, the
          capacity-building part itself.
        </p>
        <ul class='flex w-full flex-row gap-4 overflow-x-auto pt-2 scrollbar-hide snap-x lg:gap-6'>
          {
            openingCards.map((card) => (
              <li class='snap-start'>
                <a
                  href={`${deckHref}?q=${card.id}`}
                  class='block h-[225px] w-[165px] min-w-[165px] rounded-t-xl bg-gradient-to-br from-gray-light to-dark to-70% pl-[0.5px] pt-[0.5px] transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-light lg:h-[22.5rem] lg:w-[16.5rem] lg:min-w-[16.5rem]'
                  aria-label={`Open this Question in the AI Check-In deck: ${card.text}`}
                >
                  <span class='relative block h-full w-full overflow-hidden rounded-t-xl bg-dark'>
                    <Icon name='pattern-card' class='absolute -top-4 right-0 bottom-0' />
                    <span lang='en' class='block p-6 text-sm font-bold text-white lg:text-xl'>
                      {card.text}
                    </span>
                    <span
                      class='absolute right-5 bottom-5 font-title text-3xl font-bold text-primary-dark lg:right-6 lg:bottom-10 lg:text-5xl'
                      aria-hidden='true'
                    >
                      ?
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Phase 2 — the facilitated conversation -->
      <div class='flex max-w-3xl flex-col gap-4'>
        <h3 class='flex items-center gap-3 text-base font-semibold text-primary-dark lg:text-lg'>
          <span
            class='grid h-7 w-7 shrink-0 place-items-center rounded-full bg-primary-dark font-sans text-sm font-bold text-white'
            aria-hidden='true'>2</span
          >
          Go there — the facilitated conversation
        </h3>
        <p class='text-sm leading-snug text-gray-dark lg:text-base'>
          Tamas facilitates the conversation the cards opened the door to — where AI is amplifying
          each person, where it's covering for a blind spot, where the team's real disagreements
          have been going underground. The same craft as a hard conversation between two people,
          because that's what it is.
        </p>
      </div>

      <!-- Now / next -->
      <div class='grid gap-4 lg:grid-cols-2 lg:gap-6'>
        <div class='rounded-3xl border border-gray-dark bg-background p-6 lg:p-8'>
          <h4 class='mb-4 text-sm font-semibold uppercase tracking-wide text-gray-dark'>
            Where teams are now
          </h4>
          <ul class='divide-y divide-gray-light'>
            {now.map((item) => <li class='py-3 text-sm text-gray-dark lg:text-base'>{item}</li>)}
          </ul>
        </div>
        <div class='rounded-3xl border border-primary-dark/60 bg-background p-6 lg:p-8'>
          <h4 class='mb-4 text-sm font-semibold uppercase tracking-wide text-primary-dark'>
            What one conversation surfaces
          </h4>
          <ul class='divide-y divide-gray-light'>
            {next.map((item) => <li class='py-3 text-sm text-white lg:text-base'>{item}</li>)}
          </ul>
        </div>
      </div>

      <!-- Specs -->
      <dl
        class='max-w-3xl divide-y divide-gray-light rounded-3xl border border-gray-dark bg-background px-6 lg:px-8'
      >
        {
          specs.map((row) => (
            <div class='grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-6'>
              <dt class='text-xs font-semibold uppercase tracking-wide text-gray-dark sm:pt-1'>
                {row.k}
              </dt>
              <dd class='text-sm text-white lg:text-base'>
                {row.v}
                {row.dim && <span class='text-gray-dark'>{row.dim}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </PreorderSection>

  <!-- 6. WHO THIS IS FOR -->
  <PreorderSection subtitle='who this is for'>
    <Fragment slot='title'>
      Teams led by someone who <span class='text-primary-light'>already feels the gap</span>.
    </Fragment>
    <div class='flex max-w-3xl flex-col gap-6'>
      <ol class='flex flex-col gap-3'>
        {
          audiences.map((text, i) => (
            <li class='flex gap-4 rounded-2xl border border-gray-dark bg-background px-5 py-4 lg:px-6 lg:py-5'>
              <span class='shrink-0 pt-0.5 font-title text-lg font-bold text-primary-dark'>
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class='text-sm leading-snug text-gray-dark lg:text-base'>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </PreorderSection>

  <!-- 7. WHO'S ASKING -->
  <PreorderSection subtitle="who's asking" title='Two founders, one prototype.'>
    <div class='grid gap-4 lg:grid-cols-2 lg:gap-6'>
      {
        people.map((person) => (
          <div class='flex gap-5 rounded-3xl border border-gray-dark bg-background p-6 lg:p-8'>
            <span
              class='mt-1 h-11 w-11 shrink-0 rounded-xl bg-gradient-primary'
              aria-hidden='true'
            />
            <div class='flex flex-col gap-1'>
              <h3 class='font-title text-xl font-bold text-white'>{person.name}</h3>
              <p class='mb-3 text-sm text-gray-dark'>{person.role}</p>
              <p class='text-sm leading-snug text-gray-dark lg:text-base'>{person.bio}</p>
            </div>
          </div>
        ))
      }
    </div>
  </PreorderSection>

  <!-- 8. APPLY -->
  <div class='w-full px-5 pb-12 pt-8 lg:max-w-7xl xl:px-0'>
    <div
      class='relative flex flex-col items-center overflow-hidden rounded-3xl border border-gray-dark bg-background px-5 py-16 text-center lg:gap-5'
    >
      <Icon name='pattern-mobile' class='absolute left-0 right-0 top-0 lg:hidden' />
      <h3
        class='text-sm font-semibold uppercase leading-snug tracking-wide text-primary-dark lg:text-base'
      >
        Apply
      </h3>
      <h2
        class='text-gradient px-5 pt-3 text-center font-title text-4xl font-extrabold leading-10 lg:text-[54px] lg:leading-normal'
      >
        Bring your team to the table.
      </h2>
      <p
        class='max-w-xl px-5 pb-8 pt-5 text-center text-sm leading-snug lg:max-w-3xl lg:text-lg lg:leading-normal'
      >
        Tell us a little about your team and what you're noticing about how AI is showing up in it.
        We'll get back to you within a few days.
      </p>
      <span class='px-5'>
        <Button tag='a' href={applyHref} size='lg' hideIcon>Apply for a slot</Button>
      </span>
      <p class='max-w-md px-5 pt-6 text-xs leading-snug text-gray-dark lg:text-sm'>
        <strong class='font-semibold text-white'>What to include:</strong> your team, your role, roughly
        how many people, and one honest sentence about what you're noticing about AI on your team right
        now.
      </p>
      <p class='px-5 pt-4 text-xs text-gray-dark lg:text-sm'>
        Not ready for a facilitated session? <a
          href='/ai-at-work'
          class='font-semibold text-primary-dark underline underline-offset-4 transition-colors hover:text-primary-light'
          >Run the free 20-minute AI Check-In</a
        > with your team first.
      </p>
    </div>
  </div>
</Layout>
