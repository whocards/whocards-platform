---
import {Icon} from 'astro-icon/components'
import Head from '~layouts/Head.astro'
import {isNoindexRoute} from '~seo/indexation'
import '~styles/base.css'

export type Props = {title?: string; wide?: boolean}

const {title = 'SDD 2026 · WhoCards', wide = false} = Astro.props
---

<!doctype html>
<html lang='en' class='bg-background [color-scheme:dark]'>
  <head>
    <Head
      title={title}
      description='WhoCards conversation game for the SDD workshop'
      noindex={isNoindexRoute(Astro.url.pathname)}
    />
  </head>
  <body
    class='m-0 flex min-h-dvh flex-col bg-background font-sans text-white antialiased selection:bg-primary-dark selection:text-primary-light'
  >
    <div aria-hidden='true' class='pointer-events-none fixed inset-0 -z-10 overflow-hidden'>
      <div
        class='absolute -top-[35vmax] -right-[25vmax] size-[90vmax] rounded-full bg-[radial-gradient(closest-side,--alpha(var(--color-primary-dark)/32%),transparent)]'
      >
      </div>
      <div
        class='absolute -bottom-[40vmax] -left-[30vmax] size-[90vmax] rounded-full bg-[radial-gradient(closest-side,--alpha(var(--color-yellow-400)/14%),transparent)]'
      >
      </div>
      <div class='absolute inset-0 bg-hero bg-cover bg-center opacity-40'></div>
    </div>
    <header
      class='flex w-full items-center px-4 pt-4'
      class:list={[wide ? 'absolute top-0 left-0 px-8 pt-6' : 'mx-auto max-w-md']}
    >
      <Icon name='logo' class:list={[wide ? 'h-9 w-auto' : 'h-6 w-auto']} aria-label='WhoCards' />
    </header>
    <main
      class='mx-auto flex w-full flex-1 flex-col items-center px-4'
      class:list={[wide ? 'max-w-none px-0' : 'max-w-md']}
    >
      <slot />
    </main>
  </body>
</html>
