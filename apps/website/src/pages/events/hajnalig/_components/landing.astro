---
import Button from '~components/ui/Button.astro'
import {editions} from '../_data/editions'
import type {EditionYear} from '../_data/editions'
import Footer from './footer.astro'

type Props = {
  year: EditionYear
}

const {year} = Astro.props
const edition = editions[year]
// Round interactions down to a clean "+" figure for display.
const moments = Math.floor(edition.stats.moments / 100) * 100
---

<div class='w-full space-y-4 text-center md:space-y-8'>
  <h1 class='text-center font-title text-4xl font-bold md:pb-8 md:text-7xl'>
    Koccints. Kérdezz.
    <br />
    Kapcsolódj!
  </h1>
  <p class='max-w-xl justify-self-center text-center text-sm leading-4 font-semibold md:text-lg md:leading-7'>
    A kártya nálad van, és Te döntesz. Ha kíváncsi vagy kezdeményezz egy beszélgetést. A kérdéseket
    pedig értelmezd szabadon.
  </p>

  <!-- Per-edition engagement (snapshot — see _data/editions.ts) -->
  <p class='text-center text-xs font-semibold tracking-wide text-darkest/70 uppercase md:text-sm'>
    Hajnalig {edition.year} · {edition.stats.people}+ résztvevő · {edition.stats.questions} kérdés ·{' '}
    {moments.toLocaleString('hu-HU')}+ pillanat
  </p>

  <div class='mx-auto grid w-full grid-flow-row gap-4 py-2.5 md:max-w-xl md:grid-flow-col md:grid-cols-2 md:gap-8 md:py-5 lg:pt-8'>
    <Button tag='a' class='play py-2' size='lg' full href={edition.playHref}>
      Új kérdés
    </Button>
    <Button
      tag='a'
      href='/request-cards'
      full
      hideIcon
      variant='secondary'
      class='py-2 hover:bg-primary-dark/20 active:bg-primary-dark/40'
    >
      Kérj kártyát
    </Button>
  </div>
  <Footer />
</div>
