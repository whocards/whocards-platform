---
import {Icon} from 'astro-icon/components'
import {Image} from 'astro:assets'
import NavLink from '~components/Buttons/NavLink.astro'
import PostHog from '~components/PostHog.astro'
import {eventMainLinks} from '~constants/navigation'
import bgLeft from '~icons/bg-left.svg'
import bgRight from '~icons/bg-right.svg'
import Head from '~layouts/Head.astro'
import {isNoindexRoute} from '~seo/indexation'
import '~styles/base.css'

export type Props = {
  class?: string
  title?: string
  description?: string
  showFooter?: boolean
}

const {class: mainClasses, title = 'Hajnalig', description = 'Hajnalig'} = Astro.props
---

<!doctype html>
<html lang='hu' class='scroll-smooth'>
  <head>
    <Head title={title} description={description} noindex={isNoindexRoute(Astro.url.pathname)} />
    <PostHog />
  </head>
  <body class='m-0 scrollbar-hide flex min-h-screen flex-col bg-[#FFF0E8] font-sans text-darkest selection:bg-primary-dark selection:text-primary-light'>
    <nav class='navbar fixed z-10 h-16 justify-between p-4 backdrop-blur'>
      <a
        href='/events/hajnalig'
        aria-label='homepage link'
        class='text-darkest transition-colors duration-1000 hover:text-primary-dark'
      >
        <Icon name='logo-gradient' class='w-48' />
      </a>
      <ul class='menu menu-horizontal hidden items-center sm:block'>
        {eventMainLinks.map((link) => (
          <NavLink
            {...link}
            selected={Astro.url.pathname === link.href}
            class='menu-title'
            hideIcon
            size={link.button ? 'md' : 'sm'}
            dark={link.button}
            class:list={[
              !link.button &&
                'h-10 leading-[22px] text-darkest hover:bg-gray/80 hover:text-primary-light',
            ]}
          />
        ))}
      </ul>
    </nav>
    <main
      class='mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center px-4 pt-16'
      class:list={[mainClasses]}
    >
      <slot />
    </main>
    <Image
      src={bgRight}
      class='pointer-events-none fixed top-0 -right-12 h-full min-h-screen overflow-clip opacity-50 md:right-0 md:opacity-100'
      alt='background'
    />
    <Image
      src={bgLeft}
      class='pointer-events-none fixed top-0 -left-12 h-full min-h-screen overflow-clip opacity-50 md:left-0 md:opacity-100'
      alt='background'
    />
  </body>
</html>
