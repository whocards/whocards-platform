---
export const prerender = false

import {logError} from '@whocards/observability'
import {Icon} from 'astro-icon/components'
import type {Icon as IconName} from 'virtual:astro-icon'
import type {ZodIssue} from 'zod'
import {FormSuccess} from '~components/thanks'
import EmailForm from '~components/thanks/EmailForm.astro'
import {contactLinks} from '~constants/navigation'
import {env} from '~env'
import {Layout} from '~layouts'
import {insertUser} from '~server/db'
import {createContactSheetRow} from '~server/gsheet'
import {TURNSTILE_ACTION, turnstileErrorFor, verifyTurnstile} from '~server/turnstile'
import {cardRequestSchema} from '~utils/schemas'

const siteKey = env.PUBLIC_TURNSTILE_SITE_KEY

let formData: Record<string, string> | undefined
let errors: Record<string, ZodIssue> | undefined
let confirmed = false

// when form is posted
if (Astro.request.method === 'POST') {
  try {
    const rawFormData = await Astro.request.formData()
    formData = Object.fromEntries(rawFormData.entries()) as Record<string, string>

    // Bot protection: verify the Turnstile token server-side, replacing the old
    // honeypot. The secret is a required env var, so this always runs.
    const result = await verifyTurnstile(
      formData['cf-turnstile-response'] ?? '',
      env.TURNSTILE_SECRET_KEY,
      {
        action: TURNSTILE_ACTION.requestCards,
        hostname: Astro.url.hostname,
        remoteip: Astro.clientAddress,
      }
    )
    if (!result.ok) errors = turnstileErrorFor(result.reason)

    const parsed = errors ? undefined : cardRequestSchema.safeParse(formData)
    if (parsed && !parsed.success) {
      errors = Object.fromEntries(
        parsed.error.issues.map((issue) => [String(issue.path[0]), issue])
      )
    } else if (parsed?.success) {
      const request = parsed.data

      await insertUser({
        name: request.name,
        email: request.email,
        newsletter: request.newsletter ?? false,
      })

      await createContactSheetRow({
        name: request.name,
        email: request.email,
        newsletter: request.newsletter ?? false,
        requestType: 'cards',
        quantity: request.quantity,
        organization: request.organization,
        phone: request.phone,
        address: request.address,
        address2: request.address2,
        zip: request.zip,
        city: request.city,
        region: request.region,
        country: request.country,
        message: request.message,
      })

      confirmed = true
    }
  } catch (error) {
    logError('request-cards: unexpected error', error)
    errors ??= {}
  }
}
---

<Layout
  title='Request Cards'
  description='Use this form to request WhoCards for yourself or your organization. Tell us what you need and our team will follow up with you.'
  class='pt-28 lg:pt-32'
>
  <div class='grid w-full grid-flow-row items-start justify-between px-5 md:grid-flow-col md:grid-cols-2 md:px-[2vw] lg:max-w-7xl xl:px-0'>
    <div class='flex flex-col items-center justify-center gap-4 pb-14 text-center text-lg text-gray-dark md:items-start md:justify-start md:gap-5 md:text-start lg:text-xl'>
      <h1 class='font-title text-3xl leading-tight font-bold tracking-tight text-white md:pb-2 lg:text-5xl'>
        Request WhoCards
      </h1>
      <Icon name='chat' class='h-16 w-16' />
      <p class='font-semibold md:text-lg'>Tell us what you need and we will follow up.</p>
      <Icon name='divider' class='w-64 py-2 md:hidden' />
      <Icon name='divider-left' class='hidden w-3/4 py-4 md:block' />
      <div class='grid grid-cols-2 gap-3 lg:grid-cols-1'>
        {contactLinks.map((link) => (
          <a
            href={link.href}
            target='_blank'
            rel='noopener noreferrer'
            class='flex items-center gap-3 text-gray-dark hover:text-primary-light active:text-primary-dark'
          >
            <>
              <Icon name={link.icon as IconName} class='h-6 w-6' />
              <span class='block'>{link.title}</span>
            </>
          </a>
        ))}
      </div>
    </div>
    {confirmed ? (
      <FormSuccess
        class='h-full'
        type='request'
        href='/request-cards'
        title='Your card request has been submitted'
        message='Thanks for reaching out. We will get back to you shortly.'
        buttonLabel='Submit another request'
      />
    ) : (
      <EmailForm mode='request' formData={formData} errors={errors} siteKey={siteKey} />
    )}
  </div>
</Layout>
