---
export const prerender = false

import type {MetricResult, TrendPeriod, TrendPoint} from '../server/stats/types'
import Layout from '~layouts/Layout.astro'
import {getStatsSnapshot} from '../server/stats'
import {TREND_BARS} from '../server/stats/rollups'
import {TREND_PERIODS} from '../server/stats/types'

// Netlify's edge ignores s-maxage, so the CDN TTL goes in Netlify-CDN-Cache-Control.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=86400')
Astro.response.headers.set(
  'Netlify-CDN-Cache-Control',
  'public, max-age=3600, stale-while-revalidate=86400'
)

const snapshot = await getStatsSnapshot()

const fmt = (n: number) => n.toLocaleString('en-US')

const isLive = <T,>(
  result: MetricResult<T>
): result is Extract<MetricResult<T>, {status: 'live'}> => result.status === 'live'

const notConnectedMessage = (result: MetricResult<unknown>): string => {
  if (result.status === 'needs-credentials') return 'Not connected yet.'
  if (result.status === 'needs-instrumentation') return 'Coming soon.'
  return 'Temporarily unavailable.'
}

// Bucket labels are UTC because the buckets are (Monday 00:00 UTC, the 1st, Jan 1).
const utc = (iso: string, options: Intl.DateTimeFormatOptions) =>
  new Date(`${iso}T00:00:00.000Z`).toLocaleDateString('en-US', {timeZone: 'UTC', ...options})

const periodLabel: Record<TrendPeriod, (point: TrendPoint) => string> = {
  week: (p) => `Week of ${utc(p.periodStart, {month: 'short', day: 'numeric', year: 'numeric'})}`,
  month: (p) => utc(p.periodStart, {month: 'short', year: 'numeric'}),
  year: (p) => utc(p.periodStart, {year: 'numeric'}),
}

const periodCopy: Record<TrendPeriod, {tab: string; window: string; noun: string}> = {
  week: {tab: 'Week', window: `Last ${TREND_BARS.week} weeks`, noun: 'week'},
  month: {tab: 'Month', window: `Last ${TREND_BARS.month} months`, noun: 'month'},
  year: {tab: 'Year', window: 'All time', noun: 'year'},
}

const charts = TREND_PERIODS.map((period) => {
  const points = isLive(snapshot.trend) ? snapshot.trend.value[period] : []
  const max = Math.max(1, ...points.map((point) => point.count))
  const lastIndex = points.length - 1
  return {
    period,
    ...periodCopy[period],
    points: points.map((point, index) => ({
      ...point,
      label: periodLabel[period](point),
      // Height is the visual bar; the hit target is the full column, so 0-count bars still show a tooltip.
      height: Math.round((point.count / max) * 100),
      current: index === lastIndex,
    })),
    peak: Math.max(0, ...points.map((point) => point.count)),
  }
})
const hasTrend = charts.some((chart) => chart.points.length > 0)

const platformRows = isLive(snapshot.platformBreakdown)
  ? [
      {label: 'Website', count: snapshot.platformBreakdown.value.web},
      {label: 'iOS', count: snapshot.platformBreakdown.value.ios},
      {label: 'Android', count: snapshot.platformBreakdown.value.android},
      {label: 'Unattributed', count: snapshot.platformBreakdown.value.unattributed},
    ].filter((row) => row.count > 0)
  : []

const dataSinceLabel = isLive(snapshot.dataSince)
  ? new Date(snapshot.dataSince.value.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null
---

<Layout
  title='Stats'
  description='How many questions people have answered with WhoCards — the numbers behind the cards, updated regularly.'
>
  <section class='mx-auto w-full max-w-7xl px-5 pb-16 pt-20 sm:px-8 lg:px-12 lg:pt-28 2xl:px-0'>
    <p class='text-sm font-semibold tracking-wide text-primary-dark'>WhoCards stats</p>
    <h1 class='mt-4 font-title text-4xl font-bold leading-tight text-white sm:text-5xl'>
      The numbers behind the cards
    </h1>
    <p class='mt-3 max-w-xl text-base leading-7 text-gray-lighter'>
      Every question someone has answered on the web or in the app. No accounts, no per-person
      tracking, just totals.
    </p>

    <!-- Hero: questions answered -->
    <div
      class='mt-12 rounded-3xl border border-white/10 bg-dark px-6 py-10 sm:px-10 lg:px-14 lg:py-14'
    >
      {
        isLive(snapshot.questionsAnswered) ? (
          <>
            <p class='text-gradient font-title text-6xl font-extrabold leading-none sm:text-7xl lg:text-8xl'>
              {fmt(snapshot.questionsAnswered.value.total)}
            </p>
            <p class='mt-4 text-lg text-gray-lighter'>questions answered</p>
            {snapshot.questionsAnswered.value.thisWeek > 0 && (
              <p class='mt-2 text-sm text-primary-light'>
                +{fmt(snapshot.questionsAnswered.value.thisWeek)} this week
              </p>
            )}
          </>
        ) : (
          <p class='text-lg text-gray-lighter'>{notConnectedMessage(snapshot.questionsAnswered)}</p>
        )
      }
    </div>

    <!-- Platform split -->
    {
      platformRows.length > 0 && (
        <div class='mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4'>
          {platformRows.map((row) => (
            <div class='rounded-2xl border border-white/10 bg-dark px-6 py-6'>
              <p class='font-title text-3xl font-bold text-white'>{fmt(row.count)}</p>
              <p class='mt-1 text-sm text-gray-lighter'>{row.label}</p>
            </div>
          ))}
        </div>
      )
    }

    <!-- Trend -->
    <div class='mt-12'>
      <div class='flex flex-wrap items-end justify-between gap-4'>
        <h2 class='font-title text-2xl font-bold text-white'>Questions answered over time</h2>
        {
          hasTrend && (
            <div
              role='tablist'
              aria-label='Trend granularity'
              class='flex gap-1 rounded-full border border-white/10 bg-dark p-1'
            >
              {charts.map((chart) => (
                <button
                  type='button'
                  role='tab'
                  data-period-tab={chart.period}
                  aria-selected={chart.period === 'week' ? 'true' : 'false'}
                  aria-controls={`trend-${chart.period}`}
                  class='rounded-full px-4 py-1.5 text-sm font-semibold text-gray-lighter transition-colors hover:text-white aria-selected:bg-primary-dark aria-selected:text-white'
                >
                  {chart.tab}
                </button>
              ))}
            </div>
          )
        }
      </div>
      {
        hasTrend ? (
          charts.map((chart) => (
            <div
              id={`trend-${chart.period}`}
              role='tabpanel'
              data-period-chart={chart.period}
              hidden={chart.period !== 'week'}
              class='mt-6 rounded-2xl border border-white/10 bg-dark px-4 pb-3 pt-4 sm:px-6'
            >
              <div class='flex items-baseline justify-between text-xs text-gray-dark'>
                <span>
                  {chart.window} · per {chart.noun}, UTC
                </span>
                <span>Peak {fmt(chart.peak)}</span>
              </div>
              <div class='mt-3 flex h-40 items-end gap-1 border-b border-white/15 sm:gap-1.5'>
                {chart.points.map((point) => (
                  <button
                    type='button'
                    class='group relative flex h-full flex-1 items-end rounded-t outline-none'
                    aria-label={`${point.label}: ${fmt(point.count)} questions${point.current ? ' so far' : ''}`}
                  >
                    <span
                      class:list={[
                        'block w-full rounded-t transition-colors group-hover:bg-primary-light group-focus-visible:bg-primary-light',
                        point.current ? 'bg-primary-dark/40' : 'bg-primary-dark/70',
                      ]}
                      style={`height: ${point.height}%`}
                    />
                    <span
                      role='tooltip'
                      class='pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 hidden -translate-x-1/2 whitespace-nowrap rounded-lg border border-white/10 bg-black px-3 py-2 text-left text-xs text-white shadow-lg group-hover:block group-focus:block'
                    >
                      <span class='block text-gray-lighter'>
                        {point.label}
                        {point.current && ' (so far)'}
                      </span>
                      <span class='block font-title text-base font-bold'>{fmt(point.count)}</span>
                    </span>
                  </button>
                ))}
              </div>
              <div class='mt-2 flex justify-between text-xs text-gray-dark'>
                <span>{chart.points[0]?.label}</span>
                <span>{chart.points[chart.points.length - 1]?.label}</span>
              </div>
            </div>
          ))
        ) : (
          <p class='mt-4 text-gray-lighter'>{notConnectedMessage(snapshot.trend)}</p>
        )
      }
      <p class='mt-3 text-xs text-gray-dark'>
        Raw totals per period — not smoothed or averaged. Weeks start on Monday. The last bar is the
        current period and is still filling in.
      </p>
    </div>

    <!-- Counter row -->
    <div class='mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      <div class='rounded-2xl border border-white/10 bg-dark px-6 py-6'>
        <p class='font-title text-3xl font-bold text-white'>
          {isLive(snapshot.activeDevices) ? fmt(snapshot.activeDevices.value.last30Days) : '—'}
        </p>
        <p class='mt-1 text-sm text-gray-lighter'>Active devices (last 30 days)</p>
        {
          isLive(snapshot.activeDevices) && (
            <p class='mt-1 text-xs text-gray-dark'>
              {fmt(snapshot.activeDevices.value.total)} all-time
            </p>
          )
        }
      </div>
      <div class='rounded-2xl border border-white/10 bg-dark px-6 py-6'>
        <p class='font-title text-3xl font-bold text-white'>
          {isLive(snapshot.decksPlayed) ? fmt(snapshot.decksPlayed.value.total) : '—'}
        </p>
        <p class='mt-1 text-sm text-gray-lighter'>Decks played</p>
      </div>
      <div class='rounded-2xl border border-white/10 bg-dark px-6 py-6'>
        <p class='font-title text-3xl font-bold text-white'>
          {
            isLive(snapshot.languages)
              ? `${fmt(snapshot.languages.value.spoken)} of ${fmt(snapshot.languages.value.ofTotal)}`
              : '—'
          }
        </p>
        <p class='mt-1 text-sm text-gray-lighter'>Languages spoken</p>
      </div>
      <div class='rounded-2xl border border-white/10 bg-dark px-6 py-6'>
        <p class='font-title text-3xl font-bold text-white'>
          {isLive(snapshot.countries) ? fmt(snapshot.countries.value.length) : '—'}
        </p>
        <p class='mt-1 text-sm text-gray-lighter'>Countries</p>
        {
          !isLive(snapshot.countries) && (
            <p class='mt-1 text-xs text-gray-dark'>{notConnectedMessage(snapshot.countries)}</p>
          )
        }
      </div>
    </div>

    <!-- App installs -->
    <div class='mt-12'>
      <h2 class='font-title text-2xl font-bold text-white'>App installs</h2>
      <p class='mt-1 text-xs text-gray-dark'>
        Store reporting lags behind real time by about 1–2 days.
      </p>
      <div class='mt-6 grid gap-4 sm:grid-cols-2'>
        <div class='rounded-2xl border border-white/10 bg-dark px-6 py-6'>
          <p class='font-title text-3xl font-bold text-white'>
            {isLive(snapshot.installsIos) ? fmt(snapshot.installsIos.value.count) : '—'}
          </p>
          <p class='mt-1 text-sm text-gray-lighter'>iOS installs (last 30 days)</p>
          {
            !isLive(snapshot.installsIos) && (
              <p class='mt-1 text-xs text-gray-dark'>{notConnectedMessage(snapshot.installsIos)}</p>
            )
          }
        </div>
        <div class='rounded-2xl border border-white/10 bg-dark px-6 py-6'>
          <p class='font-title text-3xl font-bold text-white'>
            {isLive(snapshot.installsAndroid) ? fmt(snapshot.installsAndroid.value.count) : '—'}
          </p>
          <p class='mt-1 text-sm text-gray-lighter'>Android installs (last 30 days)</p>
          {
            !isLive(snapshot.installsAndroid) && (
              <p class='mt-1 text-xs text-gray-dark'>
                {notConnectedMessage(snapshot.installsAndroid)}
              </p>
            )
          }
        </div>
      </div>
    </div>

    <!-- Footer methodology note -->
    <div class='mt-16 border-t border-white/10 pt-8'>
      <p class='max-w-2xl text-xs leading-6 text-gray-dark'>
        A question counts as answered when its card is served — no minimum viewing time.
        {dataSinceLabel && ` Numbers reflect data recorded since ${dataSinceLabel}.`} Counts are aggregate
        totals only; WhoCards does not track or publish anything about an individual person or device.
      </p>
    </div>
  </section>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-period-tab]')
  const charts = document.querySelectorAll<HTMLElement>('[data-period-chart]')
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const period = tab.dataset.periodTab
      for (const other of tabs) other.setAttribute('aria-selected', String(other === tab))
      for (const chart of charts) chart.hidden = chart.dataset.periodChart !== period
    })
  }
</script>
