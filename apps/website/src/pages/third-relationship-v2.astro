---
import {Icon} from 'astro-icon/components'
import {Image} from 'astro:assets'
import bgLeftImage from '~assets/images/bg-left-large.svg'
import bgRightImage from '~assets/images/bg-right-large.svg'
import PreorderSection from '~components/Purchase/PreorderSection.astro'
import PreorderSectionImage from '~components/Purchase/PreorderSectionImage.astro'
import Button from '~components/ui/Button.astro'
import ImagePlaceholder from '~components/ui/ImagePlaceholder.astro'
import Layout from '~layouts/Layout.astro'

// Alternative paid B2B direction for comparison with /third-relationship.
// See docs/workshops/offering-directions.md; scope and pricing remain open.
// Voice informed by whocards-questions: lived experience, curiosity, and open discovery.
const enquiryHref =
  'mailto:tamas@innermasterylab.co?subject=' +
  encodeURIComponent('The Third Relationship — Team workshop enquiry') +
  '&body=' +
  encodeURIComponent(
    'Name:\nOrganization and team:\nWhat brings us to this conversation:\nAnything we would like to ask:\n'
  )

const specs = [
  {k: 'For', v: 'An existing team, with room for different experiences and levels of AI use.'},
  {
    k: 'Preparation',
    v: 'Before the workshop, we talk with you about your team and what brings you here.',
  },
  {k: 'Focus', v: 'Meaningful connection and more conscious working relationships.'},
  {k: 'Arrangements', v: 'A paid workshop. We discuss scope, duration, and pricing with you.'},
]

const audiences = [
  'You want to spend time getting to know the people you work with and hear what matters to them.',
  "You're curious about how AI fits into your colleagues' working lives, and how their experiences compare with yours.",
  'Your team brings different experiences of AI to the table. Enthusiasm, uncertainty, and choosing not to use it all belong in the conversation.',
]

const people = [
  {
    name: 'Tamas Meszaros',
    initials: 'TM',
    role: 'Founder, Inner Mastery Lab',
    bio: 'Tamas hosts the workshop with Avi. Both join in the sharing, bringing their own experiences of AI into the conversation and listening to what others bring.',
  },
  {
    name: 'Avi',
    initials: 'A',
    role: 'Founder, WhoCards',
    bio: 'Avi created WhoCards for meaningful human connection. His own experience of AI includes deciding, less than a week before his birthday, to get a mobile app into the App Store for his birthday, and making it happen. It felt like magic.',
  },
]

const steps = [
  {
    icon: 'card',
    title: 'Draw a Question. Take your turn.',
    body: 'You first see your Question when it is your turn to answer. Share what comes to mind, then give someone else your attention. There is room for laughter and for things that take a little longer to say. You choose what to share and can pass.',
  },
  {
    icon: 'chat',
    title: 'Talk about AI in your working life',
    body: 'Through Questions and personal stories, explore your own relationship with AI. What you enjoy, question, or choose to leave out can be part of it. Hear how someone else experiences the same tools or changes.',
  },
  {
    icon: 'group-chat',
    title: 'Follow what interests you together',
    body: 'Bring that curiosity to your relationships with colleagues. Explore how AI use can enter a decision, a request for help, or something you make together. Let each person describe what matters to them, including where your experiences differ.',
  },
  {
    icon: 'chat',
    title: 'Pause before you go',
    body: 'Take a moment to reflect, with an invitation to share if you want to. You may leave feeling closer to someone, seeing something differently, or with a thought still unfinished. You decide what to carry with you.',
  },
] as const
---

<Layout
  title='The Third Relationship: A Workshop for More Conscious Working Relationships'
  description='A facilitated team workshop for meaningful human connection and more conscious working relationships as AI becomes part of work.'
  noindex
  class='scrollbar-hide'
>
  <aside class='mt-6 w-full max-w-5xl px-8 text-center text-sm leading-6 text-gray-dark'>
    Alternative direction for discussion with Tamas.{' '}
    <a href='/third-relationship' class='underline underline-offset-4 hover:text-primary-light'
      >Compare the original page</a
    >.
  </aside>
  <!-- Alternative paid B2B offer. -->
  <div
    class='relative flex min-h-[calc(100vh-4rem)] w-full max-w-5xl flex-col justify-center gap-4 px-8 py-16 lg:items-center lg:gap-5'
  >
    <h3
      class='text-center text-sm font-semibold uppercase leading-snug tracking-wide text-primary-dark lg:text-base'
    >
      AI at work
    </h3>
    <h1
      class='text-center font-title text-4xl font-bold leading-10 text-white xs:text-3xl lg:text-7xl lg:leading-20'
    >
      Meaningful connection.<br /><span class='text-gradient'>Conscious relationships.</span>
    </h1>
    <p
      class='pb-2 text-center text-sm font-semibold leading-7 xs:leading-normal lg:px-10 lg:text-lg'
    >
      A team workshop for meaningful connection and more conscious relationships at work. Share your
      experience of AI, hear someone else's, and explore what it means for how you work together.
    </p>
    <p class='text-center text-sm text-gray-dark'>
      The Third Relationship · Inner Mastery Lab × WhoCards
    </p>
    <div
      class='mx-auto grid w-full grid-flow-row gap-8 py-5 md:max-w-xl md:grid-flow-col md:grid-cols-2 lg:pt-8'
    >
      <Button tag='a' href={enquiryHref} size='lg' full hideIcon>Ask about a team workshop</Button>
      <Button tag='a' href='/ai-at-work' full hideIcon variant='secondary'
        >Try the AI Check-In</Button
      >
    </div>
    <p class='text-center text-xs text-gray-dark'>
      A paid workshop for your team. Scope and pricing by enquiry.
    </p>
    <div class='absolute bottom-5 left-0 right-0 grid place-items-center'>
      <a
        href='#the-third-relationship'
        class='scale-150 border-0 border-x-8 border-t-8 border-solid border-x-transparent border-t-primary-light transition-transform hover:scale-[2]'
        aria-label='Scroll to learn more'
      >
      </a>
    </div>
  </div>

  <!-- The concept: AI use can affect the relationship between people. -->
  <PreorderSectionImage subtitle='the third relationship'>
    <Fragment slot='title'>
      What happens between you and AI can change what happens <span class='text-primary-dark'
        >between us</span
      >.
    </Fragment>
    <div
      class='flex h-full w-full flex-col items-center justify-center gap-8 rounded-[1.25rem] border border-gray-dark bg-background px-6 py-10 lg:px-10 lg:py-14'
    >
      <svg
        class='w-full max-w-lg'
        viewBox='0 0 400 220'
        xmlns='http://www.w3.org/2000/svg'
        role='img'
        aria-label='You and another person are connected. AI use can become part of that working relationship.'
      >
        <line x1='80' y1='150' x2='320' y2='150' class='stroke-primary-light' stroke-width='3'
        ></line>
        <line x1='80' y1='150' x2='200' y2='50' class='stroke-primary-dark' stroke-width='2'></line>
        <line
          x1='200'
          y1='50'
          x2='320'
          y2='150'
          class='stroke-gray-light'
          stroke-width='2'
          stroke-dasharray='4 4'></line>
        <circle cx='80' cy='150' r='12' class='fill-white'></circle>
        <circle cx='320' cy='150' r='12' class='fill-white'></circle>
        <circle cx='200' cy='50' r='12' class='fill-primary-dark'></circle>
        <text x='80' y='185' text-anchor='middle' class='fill-white font-sans' font-size='14'
          >You</text
        >
        <text x='320' y='185' text-anchor='middle' class='fill-white font-sans' font-size='14'
          >Another person</text
        >
        <text x='200' y='25' text-anchor='middle' class='fill-primary-dark font-sans' font-size='14'
          >AI</text
        >
      </svg>
      <p class='max-w-md text-center text-sm leading-snug text-gray-dark lg:text-base'>
        By “relationship with AI,” we mean how you use it, trust it, question it, or choose to leave
        it out.
      </p>
    </div>
    <Fragment slot='image-description'>
      <p class='text-base leading-7 text-white lg:text-lg'>
        Making something with AI can feel like magic. You might turn to it for a first idea, another
        perspective, or help with something you've never tried. Those choices can become part of
        what you bring to another person.
      </p>
      <p class='pb-2 text-sm leading-snug text-gray-dark lg:max-w-3xl lg:text-lg lg:tracking-tight'>
        The Third Relationship invites you to notice that connection in your working life. Listening
        to a colleague can help you understand what AI means to them, and consider your own choices
        with more awareness.
      </p>
    </Fragment>
  </PreorderSectionImage>

  <!-- Connection is worthwhile in itself. -->
  <PreorderSectionImage subtitle='why we gather' reverse>
    <Fragment slot='title'>
      Get to know the <span class='text-primary-light'>person behind the role</span>.
    </Fragment>
    <ImagePlaceholder
      label='People getting to know each other through conversation'
      class='lg:aspect-auto lg:h-full'
    />
    <Fragment slot='image-description'>
      <p class='text-base leading-7 text-white lg:text-lg'>
        A Question can lead to a memory, something you care about, or a little shared imagination.
        As you take turns, there is time to hear how another person sees things and let them hear
        something of you.
      </p>
      <p class='text-sm leading-snug text-gray-dark lg:max-w-3xl lg:text-lg lg:tracking-tight'>
        Connection is worthwhile in itself. An encounter can be playful, thoughtful, or stay with
        something unresolved. The conversation belongs to the people having it.
      </p>
      <p class='pb-2 text-sm leading-snug text-gray-dark lg:max-w-3xl lg:text-lg lg:tracking-tight'>
        Here, we bring that attention to work and AI. Greater awareness might help you understand a
        colleague's preference, value a practice you already have, or decide to try something. We
        hope the experience gives you something to return to in working life.
      </p>
    </Fragment>
  </PreorderSectionImage>

  <!-- Broad experience, before choosing the detailed workshop format. -->
  <PreorderSection subtitle='the experience' class='w-full'>
    <Fragment slot='title'>
      Start with a Question. <span class='text-primary-dark'
        >See where the conversation takes you.</span
      >
    </Fragment>
    <div class='flex flex-col gap-10 lg:gap-14'>
      <p class='max-w-3xl text-sm leading-snug text-gray-dark lg:text-lg lg:tracking-tight'>
        We talk with you beforehand about your team, then guide a session of Questions, stories, and
        shared exploration. The pace leaves time to answer and listen. Useful AI knowledge or ideas
        about how you work may emerge along the way.
      </p>

      <div class='flex flex-col'>
        {
          steps.map((step, index) => (
            <div class='flex gap-4 lg:gap-6'>
              <div class='flex flex-col items-center'>
                <div
                  class='relative z-10 flex h-10 w-10 items-center justify-center lg:h-14 lg:w-14'
                  class:list={[index === 0 ? 'text-primary-light' : 'text-primary-dark']}
                >
                  <Icon
                    name='usage-ring'
                    class='absolute inset-0 h-full w-full'
                    class:list={[index === 0 ? 'stroke-primary-light' : 'stroke-primary-dark']}
                    aria-hidden='true'
                  />
                  <Icon name={step.icon} class='relative z-10 h-[23px] w-[23px] lg:h-8 lg:w-8' />
                </div>
                {index < steps.length - 1 && (
                  <div class='relative z-0 -mt-[1px] w-0.5 flex-1 bg-dark' aria-hidden='true' />
                )}
              </div>
              <div class='flex min-w-0 flex-1 flex-col gap-3 pb-12 lg:pb-16'>
                <h3 class='text-lg font-semibold leading-7 lg:text-2xl lg:leading-normal'>
                  {step.title}
                </h3>
                <p class='max-w-3xl text-sm leading-snug text-gray-dark lg:text-lg lg:tracking-tight'>
                  {step.body}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Specs next to a photo of the room -->
      <div class='grid gap-4 lg:grid-cols-2 lg:gap-6'>
        <dl
          class='divide-y divide-gray-light rounded-3xl border border-gray-dark bg-background px-6 lg:px-8'
        >
          {
            specs.map((row) => (
              <div class='grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-6 lg:py-5'>
                <dt class='text-xs font-semibold uppercase tracking-wide text-gray-dark sm:pt-1'>
                  {row.k}
                </dt>
                <dd class='text-sm text-white lg:text-base'>{row.v}</dd>
              </div>
            ))
          }
        </dl>
        <ImagePlaceholder
          label='The room — cards on the table, a session in progress'
          class='lg:aspect-auto lg:h-full lg:min-h-[20rem]'
        />
      </div>
    </div>
  </PreorderSection>

  <!-- 5. WHO THIS IS FOR — three-up grid, like the homepage "what is whocards?" row -->
  <PreorderSection subtitle='who this is for' class='w-full'>
    <Fragment slot='title'>
      Bring your curiosity about <span class='text-primary-light'>each other</span>.
    </Fragment>
    <ol class='grid gap-4 lg:grid-cols-3 lg:gap-6'>
      {
        audiences.map((text, i) => (
          <li class='flex flex-col gap-3 rounded-3xl border border-gray-dark bg-background p-6 lg:p-8'>
            <span class='font-title text-3xl font-bold text-primary-dark lg:text-4xl'>
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class='text-sm leading-snug text-gray-dark lg:text-base'>{text}</p>
          </li>
        ))
      }
    </ol>
  </PreorderSection>

  <!-- 6. WHO'S ASKING — two founder cards with photo placeholders -->
  <PreorderSection subtitle='your facilitators' title='Meet Tamas and Avi.' class='w-full'>
    <div class='grid gap-4 lg:grid-cols-2 lg:gap-6'>
      {
        people.map((person) => (
          <div class='flex flex-col gap-5 rounded-3xl border border-gray-dark bg-background p-6 lg:p-8'>
            <div class='flex items-center gap-4'>
              <ImagePlaceholder
                label={`Portrait of ${person.name}`}
                shape='circle'
                initials={person.initials}
                class='h-14 w-14 lg:h-16 lg:w-16'
              />
              <div class='flex flex-col gap-0.5'>
                <h3 class='font-title text-xl font-bold text-white lg:text-2xl'>{person.name}</h3>
                <p class='text-sm text-gray-dark'>{person.role}</p>
              </div>
            </div>
            <p class='text-sm leading-snug text-gray-dark lg:text-base'>{person.bio}</p>
          </div>
        ))
      }
    </div>
  </PreorderSection>

  <!-- Enquiry: no fixed package or price has been agreed. -->
  <div class='w-full px-5 pb-12 pt-8 lg:min-h-[80vh] lg:max-w-7xl xl:px-0'>
    <div
      class='relative flex items-center overflow-hidden rounded-3xl border border-gray-dark bg-background pt-16'
    >
      <Icon name='pattern-mobile' class='absolute left-0 right-0 top-0 lg:hidden' />
      <Image
        src={bgRightImage}
        class='absolute right-0 top-0 -mr-[10%] hidden h-[110%] lg:block'
        alt='background'
      />
      <Image
        src={bgLeftImage}
        class='absolute left-0 top-0 -ml-[10%] hidden h-[110%] lg:block'
        alt='background'
      />
      <div class='flex h-full flex-1 flex-col pb-16 lg:items-center lg:gap-5'>
        <h3
          class='px-5 text-center text-sm font-semibold uppercase leading-snug tracking-wide text-primary-dark lg:text-base'
        >
          Join the conversation
        </h3>
        <h2
          class='text-gradient px-5 pt-3 text-center font-title text-4xl font-extrabold leading-10 lg:text-[54px] lg:leading-normal'
        >
          Bring your team into the conversation.
        </h2>
        <p
          class='max-w-xl self-center px-5 pb-8 pt-5 text-center text-sm leading-snug lg:max-w-3xl lg:text-lg lg:leading-normal'
        >
          Tell us who you work with and what interests you about this workshop. We'll talk through
          what it could look like for your team.
        </p>
        <span class='self-center px-5'>
          <Button tag='a' href={enquiryHref} size='lg' hideIcon>Ask about a team workshop</Button>
        </span>
        <p
          class='max-w-md self-center px-5 pt-6 text-center text-xs leading-snug text-gray-dark lg:text-sm'
        >
          Email Tamas at Inner Mastery Lab to discuss the workshop and pricing.
        </p>
      </div>
    </div>
  </div>
  <aside
    class='mb-16 w-full max-w-5xl rounded-3xl border border-gray-dark bg-background p-6 text-sm leading-7 text-gray-dark lg:p-8'
  >
    <h2 class='mb-3 font-title text-xl font-semibold text-white'>
      For discussion: the wider offering
    </h2>
    <p>
      This page explores the paid B2B direction. The separate 90-minute conference prototype brings
      together people who aren't an existing team and will help us learn about the experience.
    </p>
    <p class='mt-3'>
      A future B2C workshop could help people learn AI by making something personally meaningful,
      with sharing and connection as part of the learning. That offering is still to be developed.
    </p>
    <p class='mt-3'>
      For now, we'd value feedback on the invitation, the value for a team, and whether the emphasis
      on connection comes through. Pricing, duration, and detailed activities remain open.
    </p>
  </aside>
</Layout>
