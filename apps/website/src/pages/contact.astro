---
export const prerender = false

import {sendContactMessage} from '@whocards/emails/contact'
import {logError} from '@whocards/observability'
import {Icon} from 'astro-icon/components'
import type {ZodIssue} from 'zod'
import ContactForm from '~components/thanks/ContactForm.astro'
import {FormSuccess} from '~components/thanks'
import {contactLinks} from '~constants/navigation'
import {env} from '~env'
import {Layout} from '~layouts'
import {TURNSTILE_ACTION, turnstileErrorFor, verifyTurnstile} from '~server/turnstile'
import {contactMessageSchema} from '~utils/schemas'

const siteKey = env.PUBLIC_TURNSTILE_SITE_KEY

let formData: Record<string, string> | undefined
let errors: Record<string, ZodIssue> | undefined
let confirmed = false
let serverError: string | undefined

if (Astro.request.method === 'POST') {
  try {
    const rawFormData = await Astro.request.formData()
    formData = Object.fromEntries(rawFormData.entries()) as Record<string, string>

    // Verify the Turnstile token server-side — the client widget alone isn't
    // trustworthy. The secret is a required env var, so this always runs.
    const result = await verifyTurnstile(
      formData['cf-turnstile-response'] ?? '',
      env.TURNSTILE_SECRET_KEY,
      {
        action: TURNSTILE_ACTION.contact,
        hostname: Astro.url.hostname,
        remoteip: Astro.clientAddress,
      }
    )
    if (!result.ok) errors = turnstileErrorFor(result.reason)

    if (!errors) {
      const parsed = contactMessageSchema.safeParse(formData)
      if (!parsed.success) {
        errors = Object.fromEntries(
          parsed.error.issues.map((issue) => [String(issue.path[0]), issue])
        )
      } else if (!env.RESEND_API_KEY) {
        logError('contact: RESEND_API_KEY not configured')
        serverError =
          'Our contact system is temporarily unavailable. Please email us directly at hello@whocards.cc.'
      } else {
        const {error} = await sendContactMessage({
          apiKey: env.RESEND_API_KEY,
          from: env.RESEND_FROM_EMAIL,
          to: 'hello@whocards.cc',
          ...parsed.data,
        })

        if (error) {
          logError('contact: resend error', error)
          serverError =
            "We couldn't send your message just now. Please try again or email us directly at hello@whocards.cc."
        } else {
          confirmed = true
        }
      }
    }
  } catch (error) {
    logError('contact: unexpected error', error)
    errors ??= {}
  }
}
---

<Layout
  title='Contact'
  description='Get in touch with the WhoCards team. We are here to help with app support, general questions, and anything else you need.'
  class='pt-28 lg:pt-32'
>
  <div class='grid w-full grid-flow-row items-start justify-between px-5 md:grid-flow-col md:grid-cols-2 md:px-[2vw] lg:max-w-7xl xl:px-0'>
    <div class='flex flex-col items-center justify-center gap-4 pb-14 text-center text-lg text-gray-dark md:items-start md:justify-start md:gap-5 md:text-start lg:text-xl'>
      <h1 class='font-title text-3xl leading-tight font-bold tracking-tight text-white md:pb-2 lg:text-5xl'>
        Contact Us
      </h1>
      <Icon name='chat' class='h-16 w-16' />
      <p class='font-semibold md:text-lg'>We would love to hear from you.</p>
      <p class='text-base'>
        Reach out for app support, general questions, or anything else — we read every message.
      </p>
      <Icon name='divider' class='w-64 py-2 md:hidden' />
      <Icon name='divider-left' class='hidden w-3/4 py-4 md:block' />
      <div class='grid grid-cols-2 gap-3 lg:grid-cols-1'>
        {contactLinks.map((link) => (
          <a
            href={link.href}
            target='_blank'
            rel='noopener noreferrer'
            class='flex items-center gap-3 text-gray-dark hover:text-primary-light active:text-primary-dark'
          >
            <>
              <Icon name={link.icon as string} class='h-6 w-6' />
              <span class='block'>{link.title}</span>
            </>
          </a>
        ))}
      </div>
      <p class='mt-2 text-sm text-gray-dark'>
        Looking to order WhoCards?{' '}
        <a href='/request-cards' class='text-primary-light underline hover:text-primary-dark'>
          Request cards here.
        </a>
      </p>
    </div>

    {confirmed ? (
      <FormSuccess
        class='h-full'
        type='message'
        href='/contact'
        title='Message sent!'
        message="Thanks for reaching out. We'll get back to you soon."
        buttonLabel='Send another message'
      />
    ) : (
      <ContactForm
        formData={formData}
        errors={errors}
        serverError={serverError}
        siteKey={siteKey}
      />
    )}
  </div>
</Layout>

{siteKey && (
  <script is:inline src='https://challenges.cloudflare.com/turnstile/v0/api.js' async defer />
)}
