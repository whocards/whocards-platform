---
import {Icon} from 'astro-icon/components'
import type {Icon as IconName} from 'virtual:astro-icon'
import Button from '~components/ui/Button.astro'
import {mainLinks, socialLinks, legalLinks} from '~constants/navigation'
import {env} from '~env'
import {TURNSTILE_ACTION} from '~server/turnstile'
---

<hr class='w-full border-dark' />
<footer
  class='flex flex-col gap-12 text-gray-dark w-full px-5 py-12 md:max-w-7xl md:mx-auto xl:px-0 md:w-full md:flex-row md:justify-between md:flex-wrap'
>
  <div class='flex flex-col gap-8 items-start'>
    <Icon name='logo-plain' class='h-7 fill-white mr-auto' />
    <div class='flex flex-row gap-2.5'>
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target='_blank'
            class='bg-dark p-2 rounded-full flex items-center justify-center border border-transparent hover:border-primary-light active:border-primary-dark'
          >
            {link.icon && <Icon name={link.icon as IconName} class='h-5 w-5' />}
          </a>
        ))
      }
      <button
        id='share'
        type='button'
        class='hidden bg-dark p-2 rounded-full items-center justify-center'
      >
        <Icon name='ic:twotone-share' class='h-5 w-5' />
      </button>
    </div>
    <p class='hidden md:block'>Copyright @ 2023<br />Alles ist Dialog</p>
  </div>
  <form
    id='newsletter-form'
    class='flex w-full flex-col gap-3 md:max-w-sm'
    data-sitekey={env.PUBLIC_TURNSTILE_SITE_KEY}
    data-action={TURNSTILE_ACTION.newsletter}
  >
    <label for='newsletter-email' class='text-sm font-semibold text-white'>
      Get the occasional good question by email
    </label>
    <div class='flex flex-col gap-3 sm:flex-row'>
      <input
        id='newsletter-email'
        type='email'
        name='email'
        required
        autocomplete='email'
        inputmode='email'
        placeholder='you@example.com'
        class='min-h-12 w-full rounded-xl border border-white/25 bg-white/5 px-4 text-white placeholder:text-gray-dark focus:border-primary-light focus:outline-none focus:ring-2 focus:ring-primary-light/20'
      />
      <Button type='submit' tag='button' size='md' hideIcon disabled class='shrink-0 sm:w-auto'>
        Subscribe
      </Button>
    </div>
    <div id='newsletter-turnstile'></div>
    <p id='newsletter-status' class='min-h-5 text-sm' role='status' aria-live='polite'></p>
  </form>
  <div class='flex justify-between'>
    <div class='flex flex-col gap-4'>
      {
        mainLinks
          .filter((i) => !i.button)
          .map((link) => (
            <a
              href={link.href}
              class='text-sm font-semibold w-36 hover:text-primary-light active:underline'
            >
              {link.title}
            </a>
          ))
      }
    </div>
    <div class='flex flex-col gap-4 text-end'>
      {
        legalLinks.map((link) => (
          <a
            href={link.href}
            target='_blank'
            class='text-sm font-semibold w-36 hover:text-primary-light active:underline'
          >
            {link.title}
          </a>
        ))
      }
    </div>
  </div>
  <p class='md:hidden'>Copyright @ 2023<br />Alles ist Dialog</p>
</footer>

<script>
  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, string | (() => void)>) => string
    reset: (id: string) => void
    getResponse: (id: string) => string | undefined
  }
  const turnstile = () => (window as unknown as {turnstile?: Turnstile}).turnstile

  const form = document.getElementById('newsletter-form') as HTMLFormElement | null
  const widget = document.getElementById('newsletter-turnstile')
  const status = document.getElementById('newsletter-status')
  const submit = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null
  let widgetId: string | undefined
  // Submit waits for a Turnstile token, which arrives only after the widget loads on first focus.
  const setReady = (ready: boolean) => () => {
    if (submit) submit.disabled = !ready
  }

  // Turnstile loads on first focus so pages that never touch the footer don't pay for it.
  const renderWidget = () => {
    if (!form || !widget || widgetId !== undefined) return
    const opts = {
      sitekey: form.dataset.sitekey ?? '',
      action: form.dataset.action ?? '',
      theme: 'dark',
      callback: setReady(true),
      'expired-callback': setReady(false),
      'error-callback': setReady(false),
    }
    const render = () => (widgetId = turnstile()?.render(widget, opts))
    if (turnstile()) return render()
    const script = document.createElement('script')
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'
    script.async = true
    script.addEventListener('load', render)
    document.head.append(script)
  }
  form?.addEventListener('focusin', renderWidget, {once: true})

  const setStatus = (message: string, ok: boolean) => {
    if (!status) return
    status.textContent = message
    status.classList.toggle('text-primary-light', ok)
    status.classList.toggle('text-red-400', !ok)
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const email = new FormData(form).get('email')?.toString().trim()
    if (!email) return
    const turnstileToken = (widgetId && turnstile()?.getResponse(widgetId)) || ''

    if (submit) submit.disabled = true
    setStatus('Sending…', true)
    try {
      const res = await fetch('/api/newsletter-subscribe', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({email, turnstileToken}),
      })
      const json = (await res.json().catch(() => ({}))) as {message?: string}
      if (res.ok) {
        window.posthog?.capture('newsletter_signup', {source: 'footer'})
        form.reset()
        setStatus(json.message || 'Check your inbox to confirm.', true)
      } else {
        setStatus(json.message || 'Something went wrong. Please try again.', false)
      }
    } catch {
      setStatus('Something went wrong. Please try again.', false)
    } finally {
      if (widgetId) turnstile()?.reset(widgetId)
    }
  })

  if (navigator.share) {
    const share = document.getElementById('share') as HTMLButtonElement
    share.classList.remove('hidden')
    share.classList.add('flex')
    share.addEventListener('click', (e) => {
      e.preventDefault()
      e.stopPropagation()
      navigator.share({
        title: 'WhoCards | Request Cards',
        url: window.location.toString(),
      })
    })
  }
</script>
