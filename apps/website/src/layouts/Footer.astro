---
import {Icon} from 'astro-icon/components'
import type {Icon as IconName} from 'virtual:astro-icon'
import {mainLinks, socialLinks, legalLinks} from '~constants/navigation'
---

<hr class='w-full border-dark' />
<footer class='flex w-full flex-col gap-12 px-5 py-12 text-gray-dark md:mx-auto md:w-full md:max-w-7xl md:flex-row md:flex-wrap md:justify-between xl:px-0'>
  <div class='flex flex-col items-start gap-8'>
    <Icon name='logo-plain' class='mr-auto h-7 fill-white' />
    <div class='flex flex-row gap-2.5'>
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target='_blank'
          class='flex items-center justify-center rounded-full border border-transparent bg-dark p-2 hover:border-primary-light active:border-primary-dark'
        >
          {link.icon && <Icon name={link.icon as IconName} class='h-5 w-5' />}
        </a>
      ))}
      <button
        id='share'
        type='button'
        class='hidden items-center justify-center rounded-full bg-dark p-2'
      >
        <Icon name='ic:twotone-share' class='h-5 w-5' />
      </button>
    </div>
    <p class='hidden md:block'>
      Copyright @ 2023
      <br />
      Alles ist Dialog
    </p>
  </div>
  <div class='flex justify-between'>
    <div class='flex flex-col gap-4'>
      {mainLinks
        .filter((i) => !i.button)
        .map((link) => (
          <a
            href={link.href}
            class='w-36 text-sm font-semibold hover:text-primary-light active:underline'
          >
            {link.title}
          </a>
        ))}
    </div>
    <div class='flex flex-col gap-4 text-end'>
      {legalLinks.map((link) => (
        <a
          href={link.href}
          target='_blank'
          class='w-36 text-sm font-semibold hover:text-primary-light active:underline'
        >
          {link.title}
        </a>
      ))}
    </div>
  </div>
  <p class='md:hidden'>
    Copyright @ 2023
    <br />
    Alles ist Dialog
  </p>
</footer>

<script>
  if (navigator.share) {
    const share = document.getElementById('share') as HTMLButtonElement
    share.classList.remove('hidden')
    share.classList.add('flex')
    share.addEventListener('click', (e) => {
      e.preventDefault()
      e.stopPropagation()
      navigator.share({
        title: 'WhoCards | Request Cards',
        url: window.location.toString(),
      })
    })
  }
</script>
