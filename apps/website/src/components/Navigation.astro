---
import {Icon} from 'astro-icon/components'
import NavLink from './Buttons/NavLink.astro'
import {eventLinks} from '~constants/navigation'
import type {Link} from '~constants/navigation'
import {websiteNextUrl} from '~constants/urls'
const isQuestionPage = Astro.url.pathname.includes('question')

type Props = {
  links: Link[]
}
const {links} = Astro.props

// An event link is active on its landing page or its /play page.
const isEventSelected = (href: string) =>
  Astro.url.pathname === href || Astro.url.pathname === `${href}/play`
const onEventsPage = Astro.url.pathname.startsWith('/events/')

// Desktop nav order: the app CTA takes the prominent first slot (swapped with the
// Events dropdown), then the inline links, then Events, then the Request Cards
// button last — all evenly spaced (no divider).
const isLinkSelected = (link: Link) =>
  link.play
    ? Astro.url.pathname === '/play' || Astro.url.pathname.startsWith('/play/')
    : Astro.url.pathname === link.href
const appLink = links.find((link) => link.href === '/app')
const buttonLink = links.find((link) => link.button)
const inlineLinks = links.filter((link) => link.href !== '/app' && !link.button)
---

<div class='drawer drawer-end'>
  <input
    id='who-drawer'
    type='checkbox'
    class='drawer-toggle'
    aria-label='sidebar toggle'
    checked={false}
  />
  <div class='drawer-content transition-all' id='main'>
    <!-- Navbar -->
    <nav class='navbar fixed z-10 h-16 justify-between pr-4 pl-0 backdrop-blur md:px-4'>
      <a href='/' aria-label='homepage link'>
        <Icon name='logo' class='btn w-48 btn-ghost' />
      </a>
      <div
        class:list={['hidden flex-none flex-row items-center gap-2', {'lg:flex': !isQuestionPage}]}
      >
        <ul class='menu menu-horizontal items-center gap-1'>
          {/* App CTA first — the prominent slot, swapped with the Events dropdown. */}
          {appLink && (
            <NavLink
              {...appLink}
              selected={isLinkSelected(appLink)}
              class='menu-title text-white'
              hideIcon
              size='sm'
            />
          )}
          {inlineLinks.map((link) => (
            <NavLink
              {...link}
              selected={isLinkSelected(link)}
              class='menu-title text-white'
              hideIcon
              size='sm'
            />
          ))}
          <li>
            <details open={onEventsPage}>
              <summary class='text-lg font-bold text-white'>Events</summary>
              <ul class='z-20 rounded-xl bg-darkest'>
                {eventLinks.map((link) => (
                  <NavLink
                    {...link}
                    selected={isEventSelected(link.href)}
                    class='text-white'
                    hideIcon
                    size='sm'
                  />
                ))}
              </ul>
            </details>
          </li>
          {buttonLink && (
            <NavLink
              {...buttonLink}
              selected={isLinkSelected(buttonLink)}
              class='menu-title text-white'
              hideIcon
              size='sm'
              dark
            />
          )}
        </ul>
      </div>
    </nav>
    <!-- main content -->
    <slot />
  </div>
  <nav class='drawer-side'>
    <label for='who-drawer' class='drawer-overlay'></label>
    <ul class='menu h-full w-full flex-nowrap gap-3 bg-darkest pt-20 md:w-80 md:px-5'>
      <!-- Sidebar content here -->
      {/* App CTA first — the prominent slot, swapped with the Events dropdown. */}
      {appLink && (
        <NavLink
          {...appLink}
          selected={isLinkSelected(appLink)}
          size='lg'
          button
          variant='secondary'
          light
          hideIcon
        />
      )}
      {inlineLinks.map((link) => (
        <NavLink
          {...link}
          selected={isLinkSelected(link)}
          size='lg'
          button
          variant='secondary'
          light
          hideIcon
          class:list={[link.play && 'play']}
        />
      ))}
      <li>
        <details open={onEventsPage}>
          <summary class='text-lg font-bold text-white'>Events</summary>
          <ul>
            {eventLinks.map((link) => (
              <NavLink
                button
                variant='secondary'
                light
                size='sm'
                {...link}
                selected={isEventSelected(link.href)}
              />
            ))}
          </ul>
        </details>
      </li>
      {buttonLink && (
        <NavLink
          {...buttonLink}
          selected={isLinkSelected(buttonLink)}
          size='lg'
          button
          variant='primary'
          dark
          class:list={['menu-title']}
        />
      )}
      <NavLink
        selected={false}
        title='Login'
        href={websiteNextUrl}
        external
        class='mt-auto'
        variant='secondary'
        light
        button
      />
    </ul>
  </nav>
</div>

<!-- hamburger menu -->
<div
  class='fixed top-2 right-2 z-10 flex-none overflow-hidden rounded-2xl border border-white/30 md:right-5'
  class:list={[{'lg:hidden': !isQuestionPage}]}
>
  <label class='right btn swap btn-square swap-rotate btn-ghost' id='who-menu-button'>
    <!-- hamburger icon -->
    <svg
      class='swap-off fill-current'
      xmlns='http://www.w3.org/2000/svg'
      width='32'
      height='32'
      viewBox='0 0 512 512'
    >
      <path d='M64,384H448V341.33H64Zm0-106.67H448V234.67H64ZM64,128v42.67H448V128Z'></path>
    </svg>

    <!-- close icon -->
    <svg
      class='swap-on fill-current'
      xmlns='http://www.w3.org/2000/svg'
      width='32'
      height='32'
      viewBox='0 0 512 512'
    >
      <polygon points='400 145.49 366.51 112 256 222.51 145.49 112 112 145.49 222.51 256 112 366.51 145.49 400 256 289.49 366.51 400 400 366.51 289.49 256 400 145.49'></polygon>
    </svg>
  </label>
</div>

<!-- top of site pixel anchor -->
<div id='top-of-site-pixel-anchor' class='absolute top-24 left-0 h-px w-px'></div>

<script>
  import {initGame} from '~stores'
  initGame()
</script>

<script>
  const button = document.getElementById('who-menu-button')
  const drawer = document.getElementById('who-drawer') as HTMLInputElement | null
  const links = document.querySelectorAll('.drawer-side .menu a')
  const bg = document.querySelector('.drawer-overlay')

  if (button && drawer) {
    for (const link of links) {
      link.addEventListener('click', () => {
        drawer.checked = false
        button.classList.remove('swap-active')
      })
    }

    button.addEventListener('click', (e) => {
      e.preventDefault()
      drawer.checked = !drawer.checked
      button.classList.toggle('swap-active')
    })

    bg?.addEventListener('click', () => {
      button.classList.toggle('swap-active')
    })
  }
</script>

<script>
  const navbar = document.querySelectorAll('.navbar')[0]
  const topOfSitePixel = document.querySelector('#top-of-site-pixel-anchor')

  if (navbar && topOfSitePixel) {
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].boundingClientRect.y < 0) {
        navbar.classList.add('backdrop-blur')
      } else {
        navbar.classList.remove('backdrop-blur')
      }
    })
    observer.observe(topOfSitePixel)
  }
</script>
