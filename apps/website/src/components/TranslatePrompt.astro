---
import Button from '~components/ui/Button.astro'
import {env} from '~env'
import {TURNSTILE_ACTION} from '~server/turnstile'

const input =
  'min-h-12 w-full rounded-xl border border-white/25 bg-white/5 px-4 text-white placeholder:text-gray-dark focus:border-primary-light focus:ring-2 focus:ring-primary-light/20 focus:outline-none'
---

<dialog
  id='translate-prompt'
  class='modal modal-bottom sm:modal-middle'
  aria-labelledby='translate-prompt-title'
>
  <div class='modal-box flex max-w-md flex-col gap-4 border border-white/10 bg-darker text-white'>
    <div class='flex items-start justify-between gap-4'>
      <h2 id='translate-prompt-title' class='font-title text-2xl'>
        Help bring WhoCards to your language
      </h2>
      <form method='dialog'>
        <button class='btn btn-square btn-ghost text-xl btn-sm' aria-label='Close'>
          &times;
        </button>
      </form>
    </div>
    <p class='text-gray-lighter'>
      WhoCards isn't in your language yet. Leave your email and we'll invite you to help translate
      the questions.
    </p>
    <form
      id='translate-form'
      class='flex flex-col gap-3'
      data-sitekey={env.PUBLIC_TURNSTILE_SITE_KEY}
      data-action={TURNSTILE_ACTION.translator}
    >
      <label for='translate-email' class='text-sm font-semibold'>
        Email
      </label>
      <input
        id='translate-email'
        type='email'
        name='email'
        required
        autocomplete='email'
        inputmode='email'
        placeholder='you@example.com'
        class={input}
      />
      <label for='translate-language' class='text-sm font-semibold'>
        Language
      </label>
      <input
        id='translate-language'
        type='text'
        name='language'
        required
        maxlength={64}
        class={input}
      />
      <div id='translate-turnstile'></div>
      <Button type='submit' tag='button' size='md' hideIcon disabled full>
        I'd like to help
      </Button>
      <p id='translate-status' class='min-h-5 text-sm' role='status' aria-live='polite'></p>
    </form>
  </div>
  <form method='dialog' class='modal-backdrop'>
    <button>Close</button>
  </form>
</dialog>

<script>
  import {languageName, signupLanguage, takeTranslatePrompt} from '~utils/translate-prompt'

  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, string | (() => void)>) => string
    reset: (id: string) => void
    getResponse: (id: string) => string | undefined
  }
  const turnstile = () => (window as unknown as {turnstile?: Turnstile}).turnstile

  const dialog = document.getElementById('translate-prompt') as HTMLDialogElement | null
  const form = document.getElementById('translate-form') as HTMLFormElement | null
  const widget = document.getElementById('translate-turnstile')
  const status = document.getElementById('translate-status')
  const language = document.getElementById('translate-language') as HTMLInputElement | null
  const submit = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null
  let widgetId: string | undefined
  const setReady = (ready: boolean) => () => {
    if (submit) submit.disabled = !ready
  }

  const setStatus = (message: string, ok: boolean) => {
    if (!status) return
    status.textContent = message
    status.classList.toggle('text-primary-light', ok)
    status.classList.toggle('text-red-400', !ok)
  }

  const renderWidget = () => {
    if (!form || !widget) return
    const opts = {
      sitekey: form.dataset.sitekey ?? '',
      action: form.dataset.action ?? '',
      theme: 'dark',
      callback: setReady(true),
      'expired-callback': setReady(false),
      'error-callback': setReady(false),
    }
    const render = () => (widgetId = turnstile()?.render(widget, opts))
    if (turnstile()) return render()
    const script = document.createElement('script')
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'
    script.async = true
    script.addEventListener('load', render)
    script.addEventListener('error', () =>
      setStatus("Couldn't load the bot check. Reload the page to try again.", false)
    )
    document.head.append(script)
  }

  let due = false
  try {
    due = takeTranslatePrompt(navigator.language, localStorage, location.pathname)
  } catch {
    // Storage blocked (private mode, cookies off): without a session count, never show.
  }
  if (dialog && due) {
    if (language) language.value = languageName(navigator.language)
    dialog.showModal()
    renderWidget()
    window.posthog?.capture('translator_prompt_shown', {browser_language: navigator.language})
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const data = new FormData(form)
    const email = data.get('email')?.toString().trim()
    const typed = data.get('language')?.toString().trim()
    if (!email || !typed) return
    const lang = signupLanguage(typed, navigator.language)
    const turnstileToken = (widgetId && turnstile()?.getResponse(widgetId)) || ''

    if (submit) submit.disabled = true
    setStatus('Sending…', true)
    try {
      const res = await fetch('/api/translator-signup', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({email, language: lang, turnstileToken}),
      })
      const json = (await res.json().catch(() => ({}))) as {message?: string}
      if (res.ok) {
        window.posthog?.capture('translator_signup', {language: lang})
        form.reset()
        setStatus(json.message || 'Check your inbox to confirm.', true)
      } else {
        setStatus(json.message || 'Something went wrong. Please try again.', false)
      }
    } catch {
      setStatus('Something went wrong. Please try again.', false)
    } finally {
      if (widgetId) turnstile()?.reset(widgetId)
    }
  })
</script>
