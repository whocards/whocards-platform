---
import type {ZodIssue} from 'zod'
import Button from '~components/ui/Button.astro'
import Input from '~components/ui/Input.astro'
import {TURNSTILE_ACTION} from '~server/turnstile'

export type Props = {
  formData?: Record<string, string>
  errors?: Record<string, ZodIssue>
  serverError?: string
  siteKey?: string
}

const {formData, errors, serverError, siteKey} = Astro.props
---

<div class='flex flex-col items-center gap-4 text-center md:items-start md:gap-5 md:text-start'>
  <h2 class='text-gradient font-title text-3xl leading-tight font-bold tracking-tight lg:text-5xl'>
    Send us a message
  </h2>
  {serverError && <p class='text-red-500 lg:text-base'>{serverError}</p>}
  {errors && !serverError && (
    <p class='text-red-500 lg:text-base'>Please check the form and try again.</p>
  )}
  <form method='POST' class='flex w-full flex-col pb-14'>
    <Input
      name='name'
      minlength={2}
      autocomplete='name'
      required
      value={formData?.name ?? ''}
      error={errors?.name}
    />
    <Input
      name='email'
      type='email'
      autocomplete='email'
      required
      value={formData?.email ?? ''}
      error={errors?.email}
    />
    <label
      for='contact-message'
      class='flex flex-col gap-2 pb-2.5 text-start text-base font-medium'
    >
      <div>message *</div>
      <textarea
        id='contact-message'
        name='message'
        rows={5}
        required
        minlength={10}
        maxlength={2000}
        class='w-full rounded-xl border bg-transparent px-4.5 py-3 placeholder:text-gray-dark'
        class:list={[errors?.message ? 'border-red' : 'border-gray']}
        placeholder='How can we help?'
        set:text={formData?.message ?? ''}
      />
      <p class='text-xs text-red'>{errors?.message?.message ?? <>&nbsp;</>}</p>
    </label>

    {siteKey ? (
      <div
        class='cf-turnstile mb-4'
        data-sitekey={siteKey}
        data-action={TURNSTILE_ACTION.contact}
        data-theme='dark'
      />
    ) : null}
    {errors?.['cf-turnstile-response'] && (
      <p class='mb-4 text-xs text-red'>{errors['cf-turnstile-response'].message}</p>
    )}

    <Button type='submit' class='mt-4 capitalize lg:max-w-xs' full>
      Send message
    </Button>
  </form>
</div>
