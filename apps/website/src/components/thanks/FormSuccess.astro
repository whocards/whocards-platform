---
import {Icon} from 'astro-icon/components'
import Button from '~components/ui/Button.astro'

export type Props = {
  href: string
  type: string
  class?: string
  title?: string
  message?: string
  buttonLabel?: string
}

const {
  href,
  type,
  class: className,
  title = `Your ${type} has been submitted successfully`,
  message = `We will get back to you shortly.`,
  buttonLabel = 'Submit another request',
} = Astro.props
---

<div
  class='flex max-h-[80vh] w-full flex-col items-center justify-center gap-4 rounded-2xl border border-dark px-4 py-[25%] text-center md:max-w-lg md:py-0'
  class:list={[className]}
>
  <Icon name='check-round' class='h-16 min-h-16 w-16 min-w-[4rem] lg:h-20 lg:w-20' />
  <h1 class='pt-2 font-title text-3xl font-bold'>{title}</h1>
  <p class='text-base text-gray-dark'>{message}</p>
  <Button
    variant='secondary'
    hideIcon
    class='border-dark text-white'
    tag='a'
    href={href}
    full={false}
  >
    {buttonLabel}
  </Button>
</div>
