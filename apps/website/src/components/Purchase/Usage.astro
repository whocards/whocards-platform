---
import {Icon} from 'astro-icon/components'
import {usage} from '~constants/usage'

const {class: classes} = Astro.props
---

<div class='flex flex-col lg:pt-16' class:list={[classes]} data-usage-timeline>
  {usage.map((item, index) => (
    <div class='flex gap-4'>
      <div class='flex flex-col items-center'>
        <div
          class='relative z-10 flex h-10 w-10 items-center justify-center lg:h-14 lg:w-14'
          class:list={[index === 0 ? 'text-primary-dark' : 'text-dark']}
          data-usage-step
        >
          {index === 0 ? (
            <Icon
              name='usage-ring'
              class='absolute inset-0 h-full w-full stroke-primary-dark'
              aria-hidden='true'
            />
          ) : (
            <>
              <Icon
                name='usage-ring'
                class='absolute inset-0 h-full w-full stroke-dark'
                aria-hidden='true'
              />
              <Icon
                name='usage-ring'
                data-usage-ring
                class='absolute inset-0 h-full w-full stroke-primary-dark'
                aria-hidden='true'
                style='opacity: 0;'
              />
            </>
          )}
          <Icon name='card' class='relative z-10 h-[23px] w-[23px] lg:h-8 lg:w-8' />
        </div>
        {item.line && (
          <div class='relative z-0 -mt-[1px] w-0.5 flex-1 overflow-hidden bg-dark'>
            <div
              data-usage-line
              class='absolute top-0 left-0 w-full bg-primary-dark'
              style='height: 0;'
            />
          </div>
        )}
      </div>
      <div class='flex flex-col gap-3'>
        <h4 class='text-lg leading-7 font-semibold lg:text-2xl lg:leading-normal'>{item.title}</h4>
        <p
          class='pb-6 leading-snug text-gray-dark lg:text-lg'
          class:list={[item.line && 'lg:pb-16']}
        >
          {item.contents}
        </p>
      </div>
    </div>
  ))}
</div>

<script>
  const timeline = document.querySelector('[data-usage-timeline]')
  const steps = timeline ? Array.from(timeline.querySelectorAll('[data-usage-step]')) : []
  const lines = timeline
    ? Array.from(timeline.querySelectorAll<HTMLElement>('[data-usage-line]'))
    : []
  const rings = steps.map((step) => step.querySelector<HTMLElement>('[data-usage-ring]'))

  const updateTimeline = () => {
    if (!timeline) return
    const trigger = window.innerHeight * 0.6

    lines.forEach((line) => {
      const rect = line.parentElement?.getBoundingClientRect()
      if (!rect) return
      const filled = Math.min(Math.max(trigger - rect.top, 0), rect.height)
      line.style.height = `${filled}px`
    })

    steps.forEach((step, index) => {
      if (index === 0) return
      const ring = rings[index]
      if (!ring) return
      const rect = step.getBoundingClientRect()
      const active = trigger >= rect.top
      ring.style.opacity = active ? '1' : '0'
    })
  }

  updateTimeline()
  window.addEventListener('scroll', updateTimeline, {passive: true})
  window.addEventListener('resize', updateTimeline)
</script>
