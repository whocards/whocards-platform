---
import {Icon} from 'astro-icon/components'
import type {Icon as IconName} from 'virtual:astro-icon'
export type Props = {
  icon: string
  title: string
}

const {icon, title} = Astro.props
---

<div class='flex flex-col gap-2.5 lg:gap-3'>
  <Icon class='mb-1 h-10 w-10 lg:h-12 lg:w-12' name={icon as IconName} />
  <h4 class='text-lg leading-7.5 font-semibold lg:text-2xl lg:tracking-tight'>{title}</h4>
  <p class='text-sm text-gray-dark lg:text-base'>
    <slot />
  </p>
</div>
