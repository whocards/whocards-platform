---
export type Props = {
  title: string
  subtitle: string
  description?: string
  class?: string
}

const {title, subtitle, description, class: classes} = Astro.props
---

<div
  id={subtitle.replaceAll(' ', '-').replace('?', '')}
  class='flex snap-start flex-col gap-4 px-5 pt-16 pb-8 lg:w-full lg:max-w-7xl lg:gap-5 lg:pb-12 xl:px-0'
  class:list={[classes]}
>
  <h3 class='text-sm leading-snug font-semibold tracking-wide text-primary-dark uppercase lg:text-base lg:leading-7 lg:tracking-normal'>
    {subtitle}
  </h3>
  <h2
    class='font-title text-3xl leading-10 font-medium lg:text-[54px] lg:leading-snug lg:tracking-tighter'
    class:list={[!Astro.slots.has('outside') && 'lg:max-w-[50%]']}
  >
    {title}
  </h2>
  {description && (
    <p class='pb-2 text-sm leading-snug text-gray-dark lg:max-w-3xl lg:text-lg'>{description}</p>
  )}
  <slot />
</div>
<slot name='outside' />
