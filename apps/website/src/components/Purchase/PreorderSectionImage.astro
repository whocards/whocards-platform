---
export type Props = {
  title: string
  subtitle: string
  description?: string
  class?: string
  reverse?: boolean
  forceReverse?: boolean
}

const {title, subtitle, forceReverse, description, class: classes, reverse = false} = Astro.props
const id = subtitle.replaceAll(' ', '-').replace('?', '')
---

<div
  class='flex snap-start gap-4 px-5 pt-16 pb-8 lg:grid lg:min-h-[44.5rem] lg:w-full lg:max-w-7xl lg:grid-flow-col lg:grid-cols-2 lg:gap-14 lg:pb-12 xl:px-0'
  id={id}
  class:list={[reverse ? 'flex-col-reverse' : 'flex-col', classes]}
>
  {!reverse && <slot />}

  <span class='contents' class:list={[forceReverse && 'lg:flex lg:flex-col']}>
    <div class='flex w-full flex-col gap-4 lg:gap-5'>
      <h3 class='text-sm leading-snug font-semibold tracking-wide text-primary-dark uppercase lg:text-base lg:leading-7 lg:tracking-normal'>
        {subtitle}
      </h3>
      <h2 class='font-title text-3xl leading-10 font-semibold lg:text-[54px] lg:leading-tight lg:tracking-tighter'>
        {title}
      </h2>
      {description && (
        <p class='pb-2 text-sm leading-snug text-gray-dark lg:max-w-3xl lg:text-lg lg:tracking-tight'>
          {description}
        </p>
      )}
      <slot name='image-description' />
      <slot name='button' />
    </div>
    {reverse && <slot />}
    <slot name='end' />
  </span>
</div>
