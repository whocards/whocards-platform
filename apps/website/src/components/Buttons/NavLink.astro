---
import Button from '~components/ui/Button.astro'
import type {Props as ButtonProps} from '~components/ui/Button.astro'
import type {Link} from '~constants/navigation'

export type Props = Omit<Link, 'href'> &
  Omit<ButtonProps<'a'>, 'title'> & {
    selected: boolean
    hideIcon?: boolean
  }

const {
  href,
  title,
  button,
  selected,
  size = 'md',
  play = false,
  pop = false,
  full = false,
  external = false,
  class: classes,
  ...rest
} = Astro.props
---

<li
  class:list={{
    'pointer-events-none text-primary-light': selected && !button,
    'rounded-xl btn-ghost hover:text-primary-light hover:opacity-80 active:opacity-100':
      !selected && !button,
    'text-white': !button && !selected,
    contents: button,
  }}
>
  {button ? (
    <Button
      size={size}
      target={external ? '_blank' : '_self'}
      {...rest}
      full={full}
      tag='a'
      href={href}
      class:list={[classes]}
    >
      {title}
    </Button>
  ) : (
    <a
      href={href}
      target={external ? '_blank' : '_self'}
      class='rounded-xl text-lg font-bold transition-colors duration-300 hover:text-primary-light'
      class:list={[play && 'play', pop && 'app-cta', classes]}
    >
      {title}
    </a>
  )}
</li>
