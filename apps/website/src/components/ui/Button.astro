---
import {Icon} from 'astro-icon/components'
import type {HTMLAttributes} from 'astro/types'
import {cn} from '~utils'

// TODO Polymorphic component https://docs.astro.build/en/guides/typescript/#polymorphic-type

export type Props<T> = HTMLAttributes<'button' | 'a'> & {
  size?: 'sm' | 'md' | 'lg'
  type?: 'button' | 'submit'
  variant?: 'primary' | 'secondary'
  hideIcon?: boolean
  light?: boolean
  dark?: boolean
  href?: string
  tag?: 'button' | 'a'
  full?: boolean
  disabled?: boolean
  target?: string
  rel?: string
}

const {
  tag: Element = 'button',
  size = 'lg',
  type = 'button',
  variant = 'primary',
  hideIcon = false,
  light = false,
  dark = false,
  class: classes,
  full,
  target,
  ...props
} = Astro.props
---

<Element
  type={type}
  class:list={cn([
    'flex cursor-pointer items-center justify-center text-center transition-all duration-300 ease-in-out disabled:cursor-not-allowed disabled:opacity-50',
    variant === 'primary' &&
      !dark &&
      'bg-primary-light text-dark hover:bg-yellow-500 active:bg-yellow-300',
    variant === 'primary' &&
      dark &&
      'hover:bg-opacity-50 active:bg-opacity-75 bg-primary-dark text-white',
    variant === 'secondary' &&
      'hover:bg-opacity-25 active:bg-opacity-10 rounded-[14px] border hover:bg-gray-100 active:bg-gray-200',
    size === 'lg' &&
      'rounded-xl px-5 py-2.5 md:rounded-2xl md:px-8 md:py-3.5 md:text-lg md:font-semibold',
    size === 'md' && 'rounded-xl px-5 py-2.5',
    size === 'sm' && 'min-w-fit rounded-xl text-sm',
    variant === 'secondary'
      ? light
        ? 'border-white text-white'
        : 'border-primary-dark text-primary-dark'
      : '',
    full === undefined && 'w-full lg:w-fit',
    full !== undefined && full && 'w-full',
    classes,
  ])}
  {...props}
  {...(Element === 'a' && {target})}
>
  <span class='pointer-events-none'>
    <slot />
  </span>
  {!hideIcon && (
    <Icon
      class='ml-1.5 inline-block'
      class:list={target === '_blank' ? 'h-3 w-3' : 'mt-1 h-6 w-6'}
      name={target === '_blank' ? 'fa-solid:external-link-alt' : 'chevron'}
    />
  )}
</Element>
