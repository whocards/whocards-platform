---
import type {HTMLAttributes} from 'astro/types'
import type {ZodIssue} from 'zod'

type Props = {
  error?: ZodIssue
  name: string
  title?: string
} & HTMLAttributes<'input'>

const {error, title, name, ...props} = Astro.props
const id = `input-${name}`
---

<label for={id} class='flex flex-col gap-2 pb-2.5 text-start text-base font-medium capitalize'>
  <div>
    {title ?? name}
    {props.required ? ' *' : ''}
  </div>
  <input
    {...props}
    name={name}
    id={id}
    class='w-full rounded-xl border bg-transparent px-4.5 py-3 placeholder:text-gray-dark placeholder:capitalize'
    class:list={[error ? 'border-red' : 'border-gray']}
    placeholder={`Enter ${title ?? name}`}
  />
  <p class='text-xs text-red'>{error?.message ?? <>&nbsp;</>}</p>
</label>
