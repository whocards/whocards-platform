---
// import {donationUrl} from '~constants/urls'

export type Props = {
  name: string
  contents: Array<{
    title: string
    content: string
  }>
  class?: string
}

const {name, contents, class: classes} = Astro.props
---

<div class:list={['flex flex-col gap-3 lg:gap-5', classes]}>
  {contents?.map(({title, content}) => (
    <div class='collapse-arrow collapse border border-gray-dark'>
      <input type='radio' name={name} class='peer' />
      <div class='collapse-title p-4 pr-8 leading-relaxed font-medium peer-checked:border-b peer-checked:border-gray-dark lg:p-5 lg:text-lg'>
        {title}
      </div>
      <div class='collapse-content text-sm leading-snug text-gray-dark peer-checked:pt-4 lg:text-base lg:leading-normal lg:peer-checked:p-5'>
        <p>{content}</p>
      </div>
    </div>
  ))}
</div>
