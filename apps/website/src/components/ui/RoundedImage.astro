---
import {Image} from 'astro:assets'

export type Props = {
  src: ImageMetadata
  alt: string
  class?: string
  full?: boolean
}

const {src, alt, full = false, class: classes} = Astro.props
---

<div class:list={[full && 'h-full w-full']}>
  <Image
    src={src}
    alt={alt}
    class:list={['aspect-auto w-full rounded-[1.25rem] object-cover lg:h-full lg:w-auto', classes]}
  />
</div>
