---
import {Icon} from 'astro-icon/components'
import questions from '~/data/questions.json'
import type {Language, QuestionId} from '~types'

export type Props = {
  id: QuestionId
  lang: Language
  class?: string
}

const {id, lang, class: classes} = Astro.props
const question = questions[id][lang]
---

<div
  class='h-[225px] w-[165px] min-w-[165px] snap-start rounded-t-xl bg-gradient-to-br from-gray-light to-dark to-70% pt-[0.5px] pl-[0.5px] lg:h-[22.5rem] lg:w-[16.5rem] lg:min-w-[16.5rem]'
  class:list={[classes]}
>
  <div class='relative h-full w-full overflow-hidden rounded-t-xl bg-dark'>
    <Icon name='pattern-card' class='absolute -top-4 right-0 bottom-0' />
    <p lang={lang} class='p-6 text-sm font-bold whitespace-pre-line lg:text-xl'>
      {question}
    </p>
    <div class='absolute right-5 bottom-5 font-title text-3xl font-bold text-primary-dark lg:right-6 lg:bottom-10 lg:text-5xl'>
      ?
    </div>
  </div>
</div>
