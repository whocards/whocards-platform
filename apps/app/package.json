{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e ../../.env${ENV:+.${ENV}} --",
    "dev": "pnpm with-env vite dev",
    "build": "pnpm with-env vite build",
    "start": "pnpm with-env node .output/server/index.mjs",
    "preview": "pnpm with-env vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:migrate": "pnpm with-env drizzle-kit migrate",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "auth:generate": "pnpm with-env better-auth generate --config src/server/auth/auth.tsx -y --output src/server/auth/auth-schema.generated.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@whocards/decks": "workspace:*",
    "@whocards/emails": "workspace:*",
    "@whocards/env": "workspace:*",
    "@whocards/game": "workspace:*",
    "@whocards/tokens": "workspace:*",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.6.0",
    "zod": "catalog:"
  },
  "//kysely": "Not imported. Pins drizzle-orm's optional kysely peer to the 0.29 that @whocards/game resolves; otherwise @better-auth/cli's 0.28 splits drizzle into two copies and the game tables stop type-checking.",
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@electric-sql/pglite": "^0.5.11",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/diff": "^8.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "@whocards/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "kysely": "^0.29.7",
    "nitro": "^3.0.260610-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}
