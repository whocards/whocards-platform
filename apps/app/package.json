{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e ../../.env${ENV:+.${ENV}} --",
    "dev": "pnpm with-env vite dev",
    "build": "pnpm with-env vite build",
    "start": "pnpm with-env node .output/server/index.mjs",
    "preview": "pnpm with-env vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:migrate": "pnpm with-env drizzle-kit migrate",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "auth:generate": "pnpm with-env better-auth generate --config src/server/auth/auth.tsx -y --output src/server/auth/auth-schema.generated.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@t3-oss/env-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@whocards/decks": "workspace:*",
    "@whocards/emails": "workspace:*",
    "@whocards/tokens": "workspace:*",
    "better-auth": "^1.6.23",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@netlify/vite-plugin-tanstack-start": "^1.3.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/diff": "^8.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "@whocards/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "nitro": "^3.0.260610-beta",
    "typescript": "catalog:",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}
